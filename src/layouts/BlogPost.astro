---
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Comments from '../components/Comments.astro';
import Header from '../components/Header.astro';
import { COMMENTS_ENABLED, COURSE_SERIES, COURSE_TITLE, LANG_TAG, SITE_TITLE } from '../consts';
import { blogPostingSchema, breadcrumbSchema, ogImageFor, tagSlug } from '../lib/seo';

type Entry = CollectionEntry<'blog'>;
type Props = {
	post: Entry;
	readingTime?: number;
	wordCount?: number;
	prev?: Entry | null;
	next?: Entry | null;
};

const { post, readingTime, wordCount, prev, next } = Astro.props;
const { title, description, pubDate, updatedDate, regime, tags, series, day, lang } = post.data;
const inCourse = series === COURSE_SERIES;

const image = ogImageFor(post.id);
const schema = [
	blogPostingSchema(Astro.site, post, { image, wordCount }),
	breadcrumbSchema(Astro.site, [
		{ name: SITE_TITLE, path: '/' },
		inCourse ? { name: COURSE_TITLE, path: '/course/' } : { name: 'Writing', path: '/blog/' },
		{ name: title, path: `/blog/${post.id}/` },
	]),
];
---

<!doctype html>
<html lang={LANG_TAG[lang]}>
	<head>
		<BaseHead
			title={`${title} — ${SITE_TITLE}`}
			description={description}
			article
			publishedTime={pubDate}
			modifiedTime={updatedDate}
			tags={tags}
			lang={lang}
			image={image}
			imageAlt={title}
			schema={schema}
		/>
	</head>
	<body>
		<Header />
		<main class="shell shell--narrow">
			<article class:list={[`regime-${regime}`]}>
				<div class="post-head">
					<div class="meta">
						{inCourse && <a class="day" href="/course">Day {day}</a>}
						<FormattedDate date={pubDate} />
						{regime !== 'none' && <span class="regime">{regime}-bound</span>}
						{readingTime && <span>{readingTime} min read</span>}
					</div>
					<h1>{title}</h1>
					<p class="description">{description}</p>
					{
						tags.length > 0 && (
							<ul class="tags" aria-label="Tags">
								{tags.map((t) => (
									<li>
										<a href={`/tags/${tagSlug(t)}/`} rel="tag">{t}</a>
									</li>
								))}
							</ul>
						)
					}
				</div>

				<div class="prose">
					<slot />
					{
						updatedDate && (
							<p class="updated">
								Updated <FormattedDate date={updatedDate} />
							</p>
						)
					}
				</div>
			</article>

			{
				inCourse && (prev || next) && (
					<nav class="series-nav" aria-label="Course navigation">
						{prev ? (
							<a class="series-link" href={`/blog/${prev.id}/`}>
								<span class="series-label">← Day {prev.data.day}</span>
								<span class="series-title">{prev.data.title.replace(/^Day \d+ · /, '')}</span>
							</a>
						) : (
							<span />
						)}
						{next ? (
							<a class="series-link series-link--next" href={`/blog/${next.id}/`}>
								<span class="series-label">Day {next.data.day} →</span>
								<span class="series-title">{next.data.title.replace(/^Day \d+ · /, '')}</span>
							</a>
						) : (
							<span />
						)}
					</nav>
				)
			}

			{COMMENTS_ENABLED && <Comments slug={post.id} lang={lang} />}

			<a class="back" href={inCourse ? '/course' : '/blog'}>{inCourse ? '← 365 天课程目录' : '← All posts'}</a>
		</main>
		<Footer />
	</body>
</html>

<style>
	.post-head {
		padding-block: clamp(2.5rem, 6vw, 4rem) 1.6rem;
		border-bottom: var(--rule-weight) solid var(--rule);
	}

	.meta {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.9rem;
		font-family: var(--font-mono);
		font-size: 0.72rem;
		letter-spacing: 0.1em;
		text-transform: uppercase;
		color: var(--ink-faint);
		margin-bottom: 1.1rem;
	}

	.regime {
		border-left: 2px solid var(--rule);
		padding-left: 0.55rem;
	}

	.day {
		text-decoration: none;
		color: var(--ink);
		background: var(--paper-raised);
		border: 1px solid var(--rule);
		border-radius: 3px;
		padding: 0.15rem 0.5rem;
	}

	.day:hover {
		border-color: var(--mem);
		color: var(--mem);
	}

	.series-nav {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 1rem;
		margin-top: 3.5rem;
		padding-top: 1.5rem;
		border-top: var(--rule-weight) solid var(--rule);
	}

	.series-link {
		display: flex;
		flex-direction: column;
		gap: 0.3rem;
		text-decoration: none;
		color: var(--ink);
	}

	.series-link--next {
		text-align: right;
	}

	.series-label {
		font-family: var(--font-mono);
		font-size: 0.72rem;
		letter-spacing: 0.1em;
		text-transform: uppercase;
		color: var(--ink-faint);
	}

	.series-title {
		font-size: 0.95rem;
		color: var(--ink-soft);
	}

	.series-link:hover .series-title {
		color: var(--mem);
	}

	@media (max-width: 560px) {
		.series-nav {
			grid-template-columns: 1fr;
		}

		.series-link--next {
			text-align: left;
		}
	}

	.regime-memory .regime {
		border-left-color: var(--mem);
		color: var(--mem);
	}

	.regime-compute .regime {
		border-left-color: var(--compute);
		color: var(--compute);
	}

	h1 {
		margin-bottom: 0.9rem;
		max-width: 22ch;
	}

	.description {
		font-size: 1.08rem;
		color: var(--ink-soft);
		max-width: 36rem;
		margin-bottom: 1.1rem;
	}

	.tags a {
		text-decoration: none;
		color: inherit;
	}

	.tags a:hover {
		color: var(--mem);
	}

	.tags {
		display: flex;
		flex-wrap: wrap;
		gap: 0.9rem;
		list-style: none;
		margin: 0;
		padding: 0;
		font-family: var(--font-mono);
		font-size: 0.68rem;
		letter-spacing: 0.1em;
		text-transform: uppercase;
		color: var(--ink-faint);
	}

	.prose {
		padding-top: 2.25rem;
	}

	.updated {
		margin-top: 3rem;
		padding-top: 1rem;
		border-top: var(--rule-weight) solid var(--rule-soft);
		font-family: var(--font-mono);
		font-size: 0.72rem;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--ink-faint);
	}

	.back {
		display: inline-block;
		margin-top: 3.5rem;
		font-family: var(--font-mono);
		font-size: 0.72rem;
		letter-spacing: 0.1em;
		text-transform: uppercase;
		text-decoration: none;
		color: var(--ink-faint);
	}

	.back:hover {
		color: var(--mem);
	}
</style>
