---
/*
  The home page signature: the agent loop every lesson builds on.
  A user task enters, the model decides, a tool runs, the observation
  goes back into the context, and the loop repeats until the model answers.
  Blue = model side, amber = tools / outside world (same rule as the lesson diagrams).
  Pure CSS animation: a dot travels the loop, each stage lights up as it passes.
*/
---

<figure class="agent-loop">
	<svg viewBox="20 8 480 360" role="img" aria-labelledby="loop-title loop-desc">
		<title id="loop-title">Agent 循环</title>
		<desc id="loop-desc">用户任务进入上下文,模型决定调用工具,工具执行后把结果写回上下文,模型再决定下一步,直到给出最终回答。</desc>

		<!-- loop track -->
		<path
			id="loop-path"
			class="track"
			d="M 260 92 C 400 92, 430 150, 430 190 C 430 250, 380 290, 260 290 C 140 290, 90 250, 90 190 C 90 150, 120 92, 260 92 Z"
			fill="none"
			stroke-width="1.5"
		></path>
		<path
			class="trail"
			d="M 260 92 C 400 92, 430 150, 430 190 C 430 250, 380 290, 260 290 C 140 290, 90 250, 90 190 C 90 150, 120 92, 260 92 Z"
			fill="none"
			stroke-width="2.5"
			pathLength="100"
		></path>

		<!-- user task in -->
		<g class="io">
			<text x="260" y="26" text-anchor="middle" class="t-faint">用户任务</text>
			<line x1="260" y1="34" x2="260" y2="66" class="arrow-line"></line>
			<path d="M 255 60 L 260 68 L 265 60" class="arrow-head"></path>
		</g>

		<!-- stage: model (top) -->
		<g class="stage s-model">
			<rect x="190" y="70" width="140" height="44" rx="6" class="box-mem"></rect>
			<text x="260" y="90" text-anchor="middle" class="t-strong">LLM 决策</text>
			<text x="260" y="105" text-anchor="middle" class="t-soft">调工具还是回答?</text>
		</g>

		<!-- stage: tool call (right) -->
		<g class="stage s-call">
			<rect x="368" y="166" width="124" height="48" rx="6" class="box-mem"></rect>
			<text x="430" y="188" text-anchor="middle" class="t-strong">tool_calls</text>
			<text x="430" y="203" text-anchor="middle" class="t-soft">一段 JSON</text>
		</g>

		<!-- stage: tool runs (bottom) -->
		<g class="stage s-tool">
			<rect x="190" y="268" width="140" height="44" rx="6" class="box-cmp"></rect>
			<text x="260" y="288" text-anchor="middle" class="t-strong">执行工具</text>
			<text x="260" y="303" text-anchor="middle" class="t-soft">查库 · MCP · 搜索</text>
		</g>

		<!-- stage: observation (left) -->
		<g class="stage s-obs">
			<rect x="28" y="166" width="124" height="48" rx="6" class="box-cmp"></rect>
			<text x="90" y="188" text-anchor="middle" class="t-strong">observation</text>
			<text x="90" y="203" text-anchor="middle" class="t-soft">写回上下文</text>
		</g>

		<!-- center: context -->
		<g>
			<text x="260" y="186" text-anchor="middle" class="t-faint">messages[ ]</text>
			<text x="260" y="203" text-anchor="middle" class="t-faint">越转越长</text>
		</g>

		<!-- answer out -->
		<g class="answer">
			<line x1="330" y1="92" x2="470" y2="92" class="arrow-line ans-line"></line>
			<path d="M 464 87 L 472 92 L 464 97" class="arrow-head ans-head"></path>
			<text x="476" y="78" text-anchor="end" class="t-ans">最终回答</text>
		</g>

		<!-- moving token -->
		<circle r="6" class="dot"></circle>
		<circle r="12" class="halo"></circle>

		<!-- caption under the loop -->
		<text x="260" y="352" text-anchor="middle" class="t-faint caption">while 模型还在调工具: 执行 → 回填 → 再问一次</text>
	</svg>
	<figcaption>Day 9 手写的就是这个循环。后面的 RAG、MCP、评测、上线,都是在给它加零件。</figcaption>
</figure>

<style>
	.agent-loop {
		margin: 0;
	}

	svg {
		width: 100%;
		height: auto;
		display: block;
		overflow: visible;
	}

	text {
		font-family: var(--font-mono);
	}

	.t-strong {
		fill: var(--ink);
		font-size: 14px;
		font-weight: 600;
	}

	.t-soft {
		fill: var(--ink-soft);
		font-size: 11.5px;
	}

	.t-faint {
		fill: var(--ink-faint);
		font-size: 12px;
	}

	.t-ans {
		fill: var(--mem);
		font-size: 13px;
		font-weight: 600;
	}

	.track {
		stroke: var(--rule);
		stroke-dasharray: 4 5;
	}

	.trail {
		stroke: var(--mem);
		stroke-linecap: round;
		stroke-dasharray: 0 100;
		opacity: 0.55;
	}

	.box-mem {
		fill: var(--mem-wash);
		stroke: var(--mem);
		stroke-width: 1.2;
	}

	.box-cmp {
		fill: var(--compute-wash);
		stroke: var(--compute);
		stroke-width: 1.2;
	}

	.arrow-line {
		stroke: var(--ink-faint);
		stroke-width: 1.4;
	}

	.arrow-head {
		fill: none;
		stroke: var(--ink-faint);
		stroke-width: 1.4;
	}

	.ans-line,
	.ans-head {
		stroke: var(--mem);
	}

	.dot {
		fill: var(--mem);
	}

	.halo {
		fill: none;
		stroke: var(--mem);
		stroke-width: 1.5;
		opacity: 0;
	}

	figcaption {
		margin-top: 0.6rem;
		font-family: var(--font-mono);
		font-size: 0.72rem;
		line-height: 1.6;
		color: var(--ink-faint);
		text-align: center;
	}

	/* Static frame by default (reduced motion / no offset-path support): dot parked on the model box. */
	.dot,
	.halo {
		transform: translate(260px, 92px);
	}

	.answer {
		opacity: 0.35;
	}

	@supports (offset-path: path('M 0 0')) {
		@media (prefers-reduced-motion: no-preference) {
			.dot,
			.halo {
				transform: none;
				offset-path: path('M 260 92 C 400 92, 430 150, 430 190 C 430 250, 380 290, 260 290 C 140 290, 90 250, 90 190 C 90 150, 120 92, 260 92 Z');
				offset-rotate: 0deg;
				animation: travel 9s linear infinite;
			}

			.halo {
				animation:
					travel 9s linear infinite,
					pulse 9s ease-out infinite;
			}

			.trail {
				animation: trail 9s linear infinite;
			}

			/* Two laps through the tools, then the model answers on the third visit. */
			.stage rect {
				transition: none;
			}

			.s-model rect {
				animation: lit-model 9s linear infinite;
			}

			.s-call rect {
				animation: lit-call 9s linear infinite;
			}

			.s-tool rect {
				animation: lit-tool 9s linear infinite;
			}

			.s-obs rect {
				animation: lit-obs 9s linear infinite;
			}

			.answer {
				animation: answer 9s ease-in-out infinite;
			}
		}
	}

	/* One lap = 9s. The dot does one full lap; the answer arrow flashes near the end of the lap. */
	@keyframes travel {
		from {
			offset-distance: 0%;
		}
		to {
			offset-distance: 100%;
		}
	}

	@keyframes trail {
		from {
			stroke-dasharray: 0 100;
		}
		to {
			stroke-dasharray: 100 0;
		}
	}

	@keyframes pulse {
		0%,
		2% {
			opacity: 0.6;
			r: 6;
		}
		12% {
			opacity: 0;
			r: 18;
		}
		100% {
			opacity: 0;
		}
	}

	@keyframes lit-model {
		0%,
		6%,
		94%,
		100% {
			stroke-width: 2.6;
		}
		12%,
		88% {
			stroke-width: 1.2;
		}
	}

	@keyframes lit-call {
		0%,
		16% {
			stroke-width: 1.2;
		}
		22%,
		30% {
			stroke-width: 2.6;
		}
		36%,
		100% {
			stroke-width: 1.2;
		}
	}

	@keyframes lit-tool {
		0%,
		42% {
			stroke-width: 1.2;
		}
		48%,
		56% {
			stroke-width: 2.6;
		}
		62%,
		100% {
			stroke-width: 1.2;
		}
	}

	@keyframes lit-obs {
		0%,
		68% {
			stroke-width: 1.2;
		}
		74%,
		82% {
			stroke-width: 2.6;
		}
		88%,
		100% {
			stroke-width: 1.2;
		}
	}

	@keyframes answer {
		0%,
		90% {
			opacity: 0.3;
		}
		95% {
			opacity: 1;
		}
		100% {
			opacity: 0.3;
		}
	}
</style>
