---
import { SITE_TITLE } from '../consts';
import Loader from './Loader.astro';

const path = Astro.url.pathname;
const isCourse = path === '/course' || path.startsWith('/course/') || path.startsWith('/blog/agent-60/');
const isWriting = !isCourse && (path === '/blog' || path.startsWith('/blog/'));
const isProjects = path === '/projects' || path.startsWith('/projects/');
const isAbout = path === '/about' || path === '/about/';
---

<Loader />
<header class="site-header">
	<div class="shell bar">
		<a class="mark" href="/" aria-label={`${SITE_TITLE} 首页`}>
			<span class="glyph" aria-hidden="true">
				<svg viewBox="4 4 24 24" width="24" height="24">
					<path d="M 16 8 A 8 8 0 1 1 8 16" fill="none" stroke="#0b0e11" stroke-width="2.6" stroke-linecap="round"></path>
					<path d="M 4.9 19 L 8 15.5 L 11.1 19" fill="none" stroke="#0b0e11" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"></path>
					<circle cx="16" cy="16" r="2.4" fill="#0b0e11"></circle>
				</svg>
			</span>
			<span class="name">{SITE_TITLE}</span>
		</a>

		<nav aria-label="主导航">
			<a href="/course" class:list={[{ active: isCourse }]}>课程</a>
			<a href="/projects" class:list={[{ active: isProjects }]}>实战项目</a>
			<a href="/blog" class:list={[{ active: isWriting }]}>全部文章</a>
			<a href="/about" class:list={[{ active: isAbout }]}>关于</a>
			<a class="start" href="/blog/agent-60/day-00-overview/">开始学习</a>
		</nav>
	</div>
</header>

<style>
	/* Always dark, so it runs straight into the dark stage on the home and lesson pages. */
	.site-header {
		position: sticky;
		top: 0;
		z-index: 40;
		background: #0b0e11;
		backdrop-filter: saturate(140%) blur(10px);
		-webkit-backdrop-filter: saturate(140%) blur(10px);
		border-bottom: 1px solid #2b3139;
	}

	.bar {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1.5rem;
		height: 3.6rem;
	}

	.mark {
		display: inline-flex;
		align-items: center;
		gap: 0.65rem;
		text-decoration: none;
		color: #eaecef;
	}

	.glyph {
		display: grid;
		place-items: center;
		width: 34px;
		height: 34px;
		border-radius: 9px;
		background: #f0b90b;
		box-shadow: 0 0 0 1px rgba(240, 185, 11, 0.35), 0 4px 14px -4px rgba(240, 185, 11, 0.55);
	}

	.name {
		font-family: var(--font-display);
		font-weight: 700;
		font-size: 1.12rem;
		letter-spacing: -0.01em;
	}

	.mark:hover .glyph {
		background: #fcd535;
	}

	.mark:focus-visible,
	nav a:focus-visible {
		outline: 2px solid #f0b90b;
		outline-offset: 3px;
		border-radius: 6px;
	}

	nav {
		display: flex;
		align-items: center;
		gap: 0.3rem;
		font-family: var(--font-display);
		font-size: 0.95rem;
	}

	nav a {
		text-decoration: none;
		color: #b7bdc6;
		padding: 0.45rem 0.8rem;
		border-radius: 6px;
	}

	nav a:hover {
		color: #eaecef;
		background: #1e2329;
	}

	nav a.active {
		color: #eaecef;
		background: #2b3139;
	}

	nav a.start {
		margin-left: 0.5rem;
		color: #0b0e11;
		background: #f0b90b;
		font-weight: 600;
	}

	nav a.start:hover {
		background: #fcd535;
	}

	@media (max-width: 560px) {
		.bar {
			height: 3.2rem;
			gap: 0.6rem;
		}

		.name {
			font-size: 1rem;
		}

		.glyph {
			width: 30px;
			height: 30px;
		}

		nav {
			font-size: 0.86rem;
			gap: 0;
		}

		nav a {
			padding: 0.4rem 0.5rem;
		}

		nav a.start {
			display: none;
		}
	}

	/* Four nav links plus the wordmark don't fit a 375px phone; keep the glyph only. */
	@media (max-width: 430px) {
		.name {
			display: none;
		}
	}
</style>
