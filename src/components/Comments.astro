---
/*
  Comment thread for a post. Static markup here; the list is fetched from /api/comments
  on the client and rendered with textContent only (never innerHTML), so stored text can't
  become markup. Turnstile is loaded lazily when the form scrolls into view.
*/
import { TURNSTILE_SITEKEY } from '../consts';

interface Props {
	slug: string;
	lang: 'en' | 'zh';
}
const { slug, lang } = Astro.props;

const t =
	lang === 'zh'
		? {
				heading: '评论',
				empty: '还没有评论。第一个来聊聊?',
				loading: '加载中…',
				failed: '评论加载失败。',
				name: '昵称',
				namePh: '怎么称呼你',
				body: '评论',
				bodyPh: '算出来的数字、没跟上的地方、发现的错误,都欢迎。',
				submit: '发表评论',
				sending: '发送中…',
				verifying: '正在人机验证…',
				posted: '已发表。',
				privacy: '只保存昵称和内容。会显示你的大致地区(国家 / 省),不保存 IP 地址。',
				from: '来自',
				justNow: '刚刚',
				errors: {
					turnstile: '人机验证没通过,请重试。',
					rate: '发得太快了,稍后再试。',
					dupe: '这条你已经发过了。',
					banned: '该访客已被禁止评论。',
					links: '一条评论最多带 2 个链接。',
					name: '请填昵称(32 字以内)。',
					body: '请写点内容(1500 字以内)。',
					default: '发表失败,请重试。',
				},
			}
		: {
				heading: 'Comments',
				empty: 'No comments yet. Start the thread?',
				loading: 'Loading…',
				failed: 'Could not load comments.',
				name: 'Name',
				namePh: 'How should we call you',
				body: 'Comment',
				bodyPh: 'Numbers you worked out, places you got lost, mistakes you found — all welcome.',
				submit: 'Post comment',
				sending: 'Sending…',
				verifying: 'Verifying you are human…',
				posted: 'Posted.',
				privacy: 'Only your name and comment are stored. Your coarse region (country / state) is shown; your IP address is not kept.',
				from: 'from',
				justNow: 'just now',
				errors: {
					turnstile: 'Verification failed, please retry.',
					rate: 'Too many comments, try again later.',
					dupe: 'You already posted this.',
					banned: 'Commenting is disabled for this visitor.',
					links: 'At most 2 links per comment.',
					name: 'Please enter a name (max 32 characters).',
					body: 'Please write something (max 1500 characters).',
					default: 'Could not post, please retry.',
				},
			};
---

<section class="comments" id="comments" data-slug={slug} data-lang={lang} data-sitekey={TURNSTILE_SITEKEY}>
	<h2 class="comments-heading">
		{t.heading} <span class="count" data-count hidden></span>
	</h2>

	<ol class="list" data-list aria-live="polite">
		<li class="status" data-status>{t.loading}</li>
	</ol>

	<form class="form" data-form novalidate>
		<div class="field">
			<label for="c-name">{t.name}</label>
			<input id="c-name" name="name" type="text" maxlength="32" autocomplete="nickname" placeholder={t.namePh} required />
		</div>
		<div class="field">
			<label for="c-body">{t.body}</label>
			<textarea id="c-body" name="body" rows="5" maxlength="1500" placeholder={t.bodyPh} required></textarea>
		</div>
		<!-- honeypot: hidden from people, filled by bots -->
		<div class="hp" aria-hidden="true">
			<label for="c-website">Website</label>
			<input id="c-website" name="website" type="text" tabindex="-1" autocomplete="off" />
		</div>
		<div class="turnstile" data-turnstile></div>
		<div class="actions">
			<button type="submit" data-submit>{t.submit}</button>
			<p class="msg" data-msg role="status"></p>
		</div>
		<p class="privacy">{t.privacy}</p>
	</form>
</section>

<script is:inline define:vars={{ t }}>
	(() => {
		const root = document.getElementById('comments');
		if (!root) return;
		const slug = root.dataset.slug;
		const lang = root.dataset.lang;
		const sitekey = root.dataset.sitekey;
		const list = root.querySelector('[data-list]');
		const status = root.querySelector('[data-status]');
		const count = root.querySelector('[data-count]');
		const form = root.querySelector('[data-form]');
		const msg = root.querySelector('[data-msg]');
		const submit = root.querySelector('[data-submit]');
		const tsBox = root.querySelector('[data-turnstile]');

		const regionNames = (() => {
			try {
				return new Intl.DisplayNames([lang === 'zh' ? 'zh-CN' : 'en'], { type: 'region' });
			} catch {
				return null;
			}
		})();
		const CN = {
			Beijing: '北京', Shanghai: '上海', Tianjin: '天津', Chongqing: '重庆', Guangdong: '广东', Zhejiang: '浙江',
			Jiangsu: '江苏', Shandong: '山东', Sichuan: '四川', Hubei: '湖北', Hunan: '湖南', Henan: '河南', Hebei: '河北',
			Fujian: '福建', Anhui: '安徽', Jiangxi: '江西', Shaanxi: '陕西', Shanxi: '山西', Liaoning: '辽宁', Jilin: '吉林',
			Heilongjiang: '黑龙江', Yunnan: '云南', Guizhou: '贵州', Guangxi: '广西', Hainan: '海南', Gansu: '甘肃',
			Qinghai: '青海', Xinjiang: '新疆', Tibet: '西藏', 'Inner Mongolia': '内蒙古', Ningxia: '宁夏',
			'Hong Kong': '香港', Macau: '澳门', Taiwan: '台湾',
		};
		const formatRegion = (r) => {
			if (!r) return '';
			const [country, region] = r.split('|');
			const c = (regionNames && regionNames.of(country)) || country;
			const reg = region ? (lang === 'zh' && CN[region]) || region : '';
			return reg ? `${c} · ${reg}` : c;
		};

		const fmtDate = new Intl.DateTimeFormat(lang === 'zh' ? 'zh-CN' : 'en-GB', { year: 'numeric', month: 'short', day: 'numeric' });
		const formatTime = (ms) => {
			const diff = Date.now() - ms;
			if (diff < 60_000) return t.justNow;
			const rtf = new Intl.RelativeTimeFormat(lang === 'zh' ? 'zh-CN' : 'en', { numeric: 'auto' });
			if (diff < 3_600_000) return rtf.format(-Math.round(diff / 60_000), 'minute');
			if (diff < 86_400_000) return rtf.format(-Math.round(diff / 3_600_000), 'hour');
			if (diff < 7 * 86_400_000) return rtf.format(-Math.round(diff / 86_400_000), 'day');
			return fmtDate.format(new Date(ms));
		};

		const el = (tag, cls, text) => {
			const n = document.createElement(tag);
			if (cls) n.className = cls;
			if (text !== undefined) n.textContent = text;
			return n;
		};

		const render = (c) => {
			const li = el('li', 'item');
			const head = el('div', 'item-head');
			head.append(el('span', 'item-name', c.name));
			const region = formatRegion(c.region);
			if (region) head.append(el('span', 'item-region', `${t.from} ${region}`));
			const time = el('time', 'item-time', formatTime(c.createdAt));
			time.dateTime = new Date(c.createdAt).toISOString();
			head.append(time);
			li.append(head, el('p', 'item-body', c.body));
			return li;
		};

		const setCount = (n) => {
			count.textContent = n ? String(n) : '';
			count.hidden = !n;
		};

		let total = 0;
		fetch(`/api/comments?slug=${encodeURIComponent(slug)}`)
			.then((r) => (r.ok ? r.json() : Promise.reject(r)))
			.then(({ comments }) => {
				status.remove();
				total = comments.length;
				setCount(total);
				if (!total) list.append(el('li', 'status', t.empty));
				for (const c of comments) list.append(render(c));
			})
			.catch(() => {
				status.textContent = t.failed;
			});

		// --- Turnstile, loaded only when the form is about to be seen ---
		let widgetId = null;
		let token = '';
		let loading = false;
		const mountTurnstile = () => {
			if (loading || widgetId !== null) return;
			loading = true;
			const s = document.createElement('script');
			s.src = 'https://challenges.cloudflare.com/turnstile/v0/api.js?render=explicit';
			s.async = true;
			s.onload = () => {
				widgetId = window.turnstile.render(tsBox, {
					sitekey,
					language: lang === 'zh' ? 'zh-cn' : 'en',
					appearance: 'always',
					callback: (tok) => {
						token = tok;
						if (msg.dataset.kind === 'error') say('');
					},
					'expired-callback': () => (token = ''),
					'error-callback': (code) => {
						token = '';
						say(`${t.errors.turnstile} (${code || 'error'})`, 'error');
					},
				});
			};
			document.head.append(s);
		};
		if ('IntersectionObserver' in window) {
			const io = new IntersectionObserver((entries) => {
				if (entries.some((e) => e.isIntersecting)) {
					mountTurnstile();
					io.disconnect();
				}
			}, { rootMargin: '300px' });
			io.observe(form);
		} else mountTurnstile();
		form.addEventListener('focusin', mountTurnstile, { once: true });

		try {
			const saved = localStorage.getItem('comment-name');
			if (saved) form.elements.name.value = saved;
		} catch {}

		const say = (text, kind) => {
			msg.textContent = text;
			msg.dataset.kind = kind || '';
		};

		form.addEventListener('submit', async (e) => {
			e.preventDefault();
			const name = form.elements.name.value.trim();
			const body = form.elements.body.value.trim();
			if (!name) return say(t.errors.name, 'error');
			if (body.length < 2) return say(t.errors.body, 'error');
			if (!token) {
				// The widget may still be running its challenge — wait up to 6 s for the callback.
				say(t.verifying);
				for (let i = 0; i < 30 && !token; i++) await new Promise((r) => setTimeout(r, 200));
				if (!token) return say(t.errors.turnstile, 'error');
			}
			submit.disabled = true;
			say(t.sending);
			try {
				const res = await fetch('/api/comments', {
					method: 'POST',
					headers: { 'content-type': 'application/json' },
					body: JSON.stringify({ slug, name, body, token, website: form.elements.website.value }),
				});
				const data = await res.json().catch(() => ({}));
				if (!res.ok) {
					const detail = data.error === 'turnstile' && data.message ? ` (${data.message.replace(/^.*\(|\)$/g, '')})` : '';
					say((t.errors[data.error] || t.errors.default) + detail, 'error');
					return;
				}
				if (data.comment) {
					root.querySelector('.list .status')?.remove();
					list.append(render(data.comment));
					setCount(++total);
				}
				form.elements.body.value = '';
				say(t.posted, 'ok');
				try {
					localStorage.setItem('comment-name', name);
				} catch {}
			} catch {
				say(t.errors.default, 'error');
			} finally {
				submit.disabled = false;
				token = '';
				if (window.turnstile && widgetId !== null) window.turnstile.reset(widgetId);
			}
		});
	})();
</script>

<style is:global>
	/* Global on purpose: comment items are created by the script below, so Astro's scoped
	   attribute would never reach them. Everything is namespaced under .comments instead. */
	.comments {
		margin-top: 3.5rem;
		padding-top: 2rem;
		border-top: var(--rule-weight) solid var(--rule);
	}

	.comments .comments-heading {
		display: flex;
		align-items: baseline;
		gap: 0.6rem;
		font-size: 1.15rem;
		letter-spacing: 0;
		margin-bottom: 1.25rem;
	}

	.comments .count {
		font-family: var(--font-mono);
		font-size: 0.8rem;
		color: var(--ink-faint);
	}

	.comments .list {
		list-style: none;
		margin: 0 0 2rem;
		padding: 0;
	}

	.comments .status {
		padding: 1.25rem 0;
		color: var(--ink-faint);
		font-size: 0.95rem;
	}

	.comments .item {
		padding: 1.1rem 0;
		border-bottom: var(--rule-weight) solid var(--rule-soft);
	}

	.comments .item-head {
		display: flex;
		flex-wrap: wrap;
		align-items: baseline;
		gap: 0.75rem;
		font-family: var(--font-mono);
		font-size: 0.72rem;
		letter-spacing: 0.06em;
		color: var(--ink-faint);
		margin-bottom: 0.45rem;
	}

	.comments .item-name {
		font-family: var(--font-display);
		font-weight: 600;
		font-size: 0.95rem;
		letter-spacing: 0;
		color: var(--ink);
	}

	.comments .item-body {
		margin: 0;
		white-space: pre-wrap;
		overflow-wrap: anywhere;
		font-size: 0.98rem;
		line-height: 1.75;
		color: var(--ink-soft);
	}

	.comments .form {
		display: grid;
		gap: 1rem;
		padding: 1.4rem 1.5rem 1.2rem;
		background: var(--paper-raised);
		border: var(--rule-weight) solid var(--rule);
		border-left: 3px solid var(--mem);
		border-radius: 4px;
	}

	.comments .field {
		display: grid;
		gap: 0.4rem;
	}

	.comments label {
		font-family: var(--font-mono);
		font-size: 0.7rem;
		letter-spacing: 0.1em;
		text-transform: uppercase;
		color: var(--ink-faint);
	}

	.comments input,
	.comments textarea {
		font: inherit;
		font-size: 0.95rem;
		line-height: 1.6;
		color: var(--ink);
		background: var(--paper);
		border: 1px solid var(--rule);
		border-radius: 3px;
		padding: 0.55rem 0.7rem;
		width: 100%;
		box-sizing: border-box;
	}

	.comments input:focus,
	.comments textarea:focus {
		outline: none;
		border-color: var(--mem);
		box-shadow: 0 0 0 3px var(--mem-wash);
	}

	.comments textarea {
		resize: vertical;
		min-height: 6rem;
	}

	.comments .hp {
		position: absolute;
		left: -10000px;
		width: 1px;
		height: 1px;
		overflow: hidden;
	}

	.comments .turnstile:empty {
		display: none;
	}

	.comments .actions {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 1rem;
	}

	.comments button {
		font-family: var(--font-mono);
		font-size: 0.74rem;
		letter-spacing: 0.1em;
		text-transform: uppercase;
		color: var(--paper-raised);
		background: var(--mem);
		border: 0;
		border-radius: 3px;
		padding: 0.7rem 1.1rem;
		cursor: pointer;
	}

	.comments button:hover {
		filter: brightness(1.08);
	}

	.comments button:disabled {
		opacity: 0.55;
		cursor: default;
	}

	.comments .msg {
		margin: 0;
		font-size: 0.88rem;
		color: var(--ink-faint);
	}

	.comments .msg[data-kind='error'] {
		color: var(--compute);
	}

	.comments .msg[data-kind='ok'] {
		color: var(--mem);
	}

	.comments .privacy {
		margin: 0;
		font-size: 0.78rem;
		line-height: 1.6;
		color: var(--ink-faint);
	}
</style>
