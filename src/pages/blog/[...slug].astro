---
import { getCollection, render } from 'astro:content';
import BlogPost from '../../layouts/BlogPost.astro';
import { COURSE_SERIES, INFRA_SERIES } from '../../consts';

export async function getStaticPaths() {
	const posts = await getCollection('blog', ({ data }) => !data.draft);
	// Each day-by-day track gets its own strip and prev/next: agent-60 and aiinfra-365.
	const trackOf = (series?: string) =>
		posts
			.filter((p) => p.data.series === series && p.data.day !== undefined)
			.sort((a, b) => a.data.day! - b.data.day!);
	const tracks = new Map([COURSE_SERIES, INFRA_SERIES].map((s) => [s, trackOf(s)]));
	return posts.map((post) => {
		const course = tracks.get(post.data.series ?? '') ?? tracks.get(COURSE_SERIES)!;
		const i = course.findIndex((p) => p.id === post.id);
		return {
			params: { slug: post.id },
			props: { post, course: course.map((c) => ({ id: c.id, day: c.data.day!, title: c.data.title })), prev: i > 0 ? course[i - 1] : null, next: i >= 0 && i < course.length - 1 ? course[i + 1] : null },
		};
	});
}

const { post, prev, next, course } = Astro.props;
const { Content, headings, remarkPluginFrontmatter } = await render(post);
---

<BlogPost
	post={post}
	readingTime={remarkPluginFrontmatter.readingTime}
	wordCount={remarkPluginFrontmatter.wordCount}
	prev={prev}
	next={next}
	course={course}
	headings={headings.filter((h) => h.depth === 2)}
>
	<Content />
</BlogPost>
