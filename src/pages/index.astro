---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Loader from '../components/Loader.astro';
import { SITE_TITLE } from '../consts';
import { personSchema, websiteSchema } from '../lib/seo';

// One request, end to end, told for someone who has never seen the inside of an AI system.
// `term` is the engineer's name for the step; `stat` is the number that makes it real; `ms` drives the HUD clock.
const STEPS = [
	{ key: 'PROMPT', layer: 'YOU', ms: 0, title: 'You ask a question', body: 'You type one sentence and press Enter. To you it is a message. To the machine it is the start of a relay race through thousands of kilometres of cable and billions of calculations.', term: 'HTTPS request', stat: '≈ 60 bytes of text' },
	{ key: 'EDGE', layer: 'INFRA', ms: 40, title: 'It crosses the world in a blink', body: 'Your message flies to a data centre, often on another continent. A gatekeeper checks who you are, makes sure nobody is flooding the line, and sends you to a free machine.', term: 'API gateway · TLS · rate limiting', stat: '≈ 40 ms across the ocean' },
	{ key: 'AGENT', layer: 'AGENT', ms: 55, title: 'An assistant picks up the job', body: 'Before any thinking happens, a program wrapped around the AI reads your request, recalls what you said earlier, and checks which tools it is allowed to use. This program is the agent.', term: 'Agent runtime', stat: '3 tools on hand' },
	{ key: 'RETRIEVE', layer: 'AGENT', ms: 90, title: 'It looks things up first', body: 'The AI never memorised this company\'s refund policy. So the agent turns your question into a point in a "map of meaning" and fetches the documents sitting closest to it.', term: 'Retrieval-augmented generation (RAG)', stat: 'top 5 of 1.2 million passages' },
	{ key: 'TOKENIZE', layer: 'MODEL', ms: 110, title: 'Words become numbers', body: 'Computers cannot read. Every word is chopped into small pieces called tokens, and each piece is swapped for a number. From here on, the AI only ever sees numbers.', term: 'Tokenizer', stat: '"refund" → 21639' },
	{ key: 'SCHEDULE', layer: 'INFRA', ms: 125, title: 'It joins a very fast queue', body: 'Thousands of people are asking at the same moment. A scheduler packs everyone\'s requests together, like a bus that never leaves half empty, so the expensive chips are never idle.', term: 'Continuous batching · KV cache', stat: '256 conversations per batch' },
	{ key: 'GPU', layer: 'INFRA', ms: 140, title: 'The heavy lifting begins', body: 'Eight chips, each costing about as much as a car, hold the AI\'s brain between them. To write a single word, the whole brain has to stream through their memory once.', term: 'GPU cluster · tensor parallelism', stat: '≈ 3 TB per second, per chip' },
	{ key: 'FORWARD', layer: 'MODEL', ms: 300, title: 'Billions of dials turn at once', body: 'Your numbers rise through 80 layers. In each one, every word asks "which other words matter to me?" and updates itself. The dials were set months earlier by reading trillions of words.', term: 'Transformer · self-attention', stat: '70 billion parameters' },
	{ key: 'SAMPLE', layer: 'MODEL', ms: 320, title: 'It guesses the next word', body: 'Out comes a list of odds for every possible next word. It picks one, adds it to the sentence, and runs the whole brain again for the next. That is the secret: extraordinarily good autocomplete.', term: 'Next-token prediction · sampling', stat: '1 word every ≈ 25 ms' },
	{ key: 'TOOL', layer: 'AGENT', ms: 900, title: 'It can act, not just talk', body: 'Instead of a word, the AI can ask for a tool. The agent runs it, here by looking up your invoices, and hands back the result, so the answer is built on facts rather than guesses.', term: 'Tool calling', stat: '1 live database query' },
	{ key: 'STREAM', layer: 'INFRA', ms: 1250, title: 'The answer arrives word by word', body: 'Each new word is turned back into text and sent to your screen the moment it exists. That is why AI answers seem to type themselves.', term: 'Streaming · server-sent events', stat: 'first word in ≈ 0.3 s' },
	{ key: 'RECAP', layer: 'ALL', ms: 1800, title: 'So what is AI, really?', body: 'A model that learned language by predicting the next word. An agent that gives it memory and hands. An infrastructure that makes it fast enough to feel like magic. Three layers, one answer, under two seconds.', term: 'Model · Agent · Infra', stat: '≈ 1.8 s end to end' },
	{ key: 'CHOOSE', layer: 'YOU', ms: 1800, title: 'Pick a layer to go deeper', body: 'AI Infra is the factory: chips, memory and serving. AI Agent is the hands: tools, retrieval and real products. Both start here.', term: '', stat: '' },
];

const description =
	'What actually happens in the two seconds after you ask an AI a question, explained in plain words: the agent, the lookup, words turned into numbers, the GPUs, the 70-billion-parameter model guessing the next word, tool calls and streaming. Then pick a track: AI Infra or AI Agent.';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`The anatomy of an answer — ${SITE_TITLE}`} description={description} schema={[websiteSchema(Astro.site), personSchema(Astro.site)]} />
	</head>
	<body class="home3d">
		<Loader />
		<main>
			<section class="journey" data-journey style={`--steps:${STEPS.length}`} aria-label="From prompt to answer, step by step">
				<div class="viewport">
					<canvas class="gl" data-gl aria-hidden="true"></canvas>
					<div class="vignette" aria-hidden="true"></div>

					<div class="hud" data-hud aria-live="polite">
						<p class="hud-kicker"><span class="hud-num" data-hud-num>01</span><span class="hud-sep">/</span><span>{String(STEPS.length).padStart(2, '0')}</span><span class="hud-clock" data-hud-clock>T+ 0.000 s</span><span class="hud-layer" data-hud-layer>{STEPS[0].layer}</span></p>
						<h2 class="hud-title" data-hud-title>{STEPS[0].title}</h2>
						<p class="hud-body" data-hud-body>{STEPS[0].body}</p>
						<div class="hud-foot" data-hud-foot>
							<p class="hud-stat" data-hud-stat>{STEPS[0].stat}</p>
							<p class="hud-term">In tech terms: <span data-hud-term>{STEPS[0].term}</span></p>
						</div>
					</div>

					<div class="intro" data-intro>
						<p class="intro-eyebrow">aiinfra.blog <span class="sep">/</span> The anatomy of an answer</p>
						<h1 class="intro-title">Every answer <br />begins with <span class="key">Enter</span></h1>
						<p class="intro-sub">Behind one keystroke, an agent plans, a GPU cluster wakes up and billions of parameters fire in sequence. Follow a single prompt through the entire stack, from the first token to the last.</p>
						<p class="intro-hint"><span class="mouse" aria-hidden="true"><i></i></span>Scroll to send it</p>
					</div>

					<div class="choose" id="choose" data-choose>
						<a class="door door-infra" href="/infra">
							<span class="door-tag">Track 01</span>
							<span class="door-name">AI Infra</span>
							<span class="door-body">Serving, GPUs, KV cache, batching, kernels. The machinery under the model.</span>
							<span class="door-go">Enter AI Infra <b aria-hidden="true">→</b></span>
						</a>
						<a class="door door-agent" href="/agent">
							<span class="door-tag">Track 02</span>
							<span class="door-name">AI Agent</span>
							<span class="door-body">Tool calling, RAG, MCP, evals, production. Building systems that do real work.</span>
							<span class="door-go">Enter AI Agent <b aria-hidden="true">→</b></span>
						</a>
					</div>

					<nav class="rail" data-rail aria-label="Jump to a step">
						<span class="rail-line" aria-hidden="true"><span class="rail-fill" data-rail-fill></span></span>
						<ol>
							{
								STEPS.map((s, i) => (
									<li>
										<button type="button" data-rail-step={i} class:list={[`l-${s.layer.toLowerCase()}`]}>
											<span class="dot" aria-hidden="true" />
											<span class="lbl">{s.key}</span>
										</button>
									</li>
								))
							}
						</ol>
					</nav>
					<a class="skip" href="#choose" data-skip>Skip <span aria-hidden="true">→</span></a>
					<p class="fineprint">Illustrative numbers. The flow is real.</p>
				</div>
			</section>

			<!-- Readable version of the same walk-through: shown without WebGL or with reduced motion. -->
			<section class="static-walk" data-static>
				<div class="shell">
					<h1 class="sw-title">Every answer begins with Enter</h1>
					<ol class="sw-list">
						{
							STEPS.slice(0, -1).map((s, i) => (
								<li>
									<span class="sw-num">{String(i + 1).padStart(2, '0')}</span>
									<span class={`sw-layer l-${s.layer.toLowerCase()}`}>{s.layer}</span>
									<h2>{s.title}</h2>
									<p>{s.body}</p>
									{s.term && <p class="sw-term">{s.stat} · {s.term}</p>}
								</li>
							))
						}
					</ol>
					<div class="sw-doors">
						<a class="door door-infra" href="/infra"><span class="door-name">AI Infra</span><span class="door-body">Serving, GPUs, KV cache, batching, kernels.</span></a>
						<a class="door door-agent" href="/agent"><span class="door-name">AI Agent</span><span class="door-body">Tool calling, RAG, MCP, evals, production.</span></a>
					</div>
				</div>
			</section>
		</main>
		<Footer />

		<script type="application/json" id="journey-steps" set:html={JSON.stringify(STEPS)} />
		<script>
			import { startJourney } from '../scripts/journey';
			startJourney();
		</script>
	</body>
</html>

<style>
	:global(body.home3d) {
		background: #04060a;
	}

	.journey {
		position: relative;
		height: calc(var(--steps) * 115vh);
		background: #04060a;
		color: #eaecef;
	}

	.viewport {
		position: sticky;
		top: 0;
		height: 100vh;
		height: 100svh;
		overflow: hidden;
	}

	.gl {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		display: block;
	}

	.vignette {
		position: absolute;
		inset: 0;
		pointer-events: none;
		background:
			radial-gradient(120% 90% at 50% 45%, transparent 55%, rgba(2, 3, 6, 0.85) 100%),
			linear-gradient(180deg, rgba(4, 6, 10, 0.55) 0%, transparent 18%, transparent 78%, rgba(4, 6, 10, 0.75) 100%);
	}

	/* ---------- Intro title (fades as the request leaves) ---------- */
	.intro {
		position: absolute;
		left: var(--gutter);
		right: var(--gutter);
		top: 50%;
		transform: translateY(-50%);
		max-width: 80rem;
		margin-inline: auto;
		pointer-events: none;
		transition: opacity 0.4s linear;
	}

	.intro > * {
		max-width: 34rem;
	}

	.intro-eyebrow .sep {
		margin: 0 0.5em;
		color: #5e6673;
	}

	.intro-eyebrow {
		margin: 0 0 1rem;
		font-family: var(--font-mono);
		font-size: 0.8rem;
		letter-spacing: 0.24em;
		text-transform: uppercase;
		color: #f0b90b;
	}

	.intro-title {
		margin: 0;
		font-family: var(--font-display);
		font-weight: 700;
		font-size: clamp(2.4rem, 5.6vw, 4.6rem);
		line-height: 1.02;
		letter-spacing: -0.035em;
		color: #f5f6f7;
	}

	.key {
		display: inline-block;
		padding: 0.02em 0.28em 0.06em;
		border: 1px solid rgba(240, 185, 11, 0.6);
		border-bottom-width: 4px;
		border-radius: 0.18em;
		color: #f0b90b;
		background: rgba(240, 185, 11, 0.07);
		box-shadow: 0 0 40px -6px rgba(240, 185, 11, 0.55);
		animation: keypress 2.8s ease-in-out infinite;
	}

	@keyframes keypress {
		0%, 70%, 100% { transform: translateY(0); border-bottom-width: 4px; }
		76% { transform: translateY(3px); border-bottom-width: 1px; }
	}

	.intro > .intro-sub {
		max-width: 29rem;
	}

	.intro-sub {
		margin: 1.4rem 0 0;
		font-family: var(--font-display);
		font-size: clamp(1rem, 1.4vw, 1.2rem);
		line-height: 1.55;
		color: #b7bdc6;
	}

	.intro-hint {
		display: flex;
		align-items: center;
		gap: 0.7rem;
		margin: 2.6rem 0 0;
		font-family: var(--font-mono);
		font-size: 0.78rem;
		letter-spacing: 0.18em;
		text-transform: uppercase;
		color: #848e9c;
	}

	.mouse {
		position: relative;
		width: 20px;
		height: 30px;
		border: 1.5px solid #848e9c;
		border-radius: 10px;
	}

	.mouse i {
		position: absolute;
		left: 50%;
		top: 6px;
		width: 3px;
		height: 6px;
		margin-left: -1.5px;
		border-radius: 2px;
		background: #f0b90b;
		animation: wheel 1.6s ease-in-out infinite;
	}

	@keyframes wheel {
		0% { transform: translateY(0); opacity: 1; }
		80% { transform: translateY(10px); opacity: 0; }
		100% { transform: translateY(0); opacity: 0; }
	}

	/* ---------- HUD: the current step ---------- */
	.hud {
		position: absolute;
		left: max(var(--gutter), calc((100vw - 80rem) / 2 + var(--gutter)));
		bottom: 8.5rem;
		width: min(29rem, calc(100vw - 2 * var(--gutter)));
		padding: 1.3rem 1.4rem 1.4rem;
		border: 1px solid rgba(255, 255, 255, 0.08);
		border-radius: 14px;
		background: linear-gradient(160deg, rgba(20, 24, 31, 0.72), rgba(8, 10, 14, 0.6));
		-webkit-backdrop-filter: blur(14px) saturate(140%);
		backdrop-filter: blur(14px) saturate(140%);
		box-shadow: 0 30px 80px -30px rgba(0, 0, 0, 0.8), inset 0 1px 0 rgba(255, 255, 255, 0.05);
		opacity: 0;
		transform: translateY(14px);
		transition: opacity 0.5s ease, transform 0.5s cubic-bezier(0.22, 1, 0.36, 1);
		pointer-events: none;
	}

	.hud.on {
		opacity: 1;
		transform: none;
	}

	.hud.swap .hud-title,
	.hud.swap .hud-body {
		opacity: 0;
		transform: translateY(6px);
		filter: blur(4px);
	}

	.hud-kicker {
		display: flex;
		align-items: baseline;
		gap: 0.35rem;
		margin: 0 0 0.55rem;
		font-family: var(--font-mono);
		font-size: 0.78rem;
		color: #707a8a;
	}

	.hud-num {
		font-size: 1.05rem;
		font-weight: 600;
		color: #eaecef;
	}

	.hud-layer {
		margin-left: auto;
		padding: 0.12rem 0.55rem;
		border-radius: 999px;
		font-size: 0.68rem;
		letter-spacing: 0.16em;
		border: 1px solid currentColor;
		color: var(--layer, #848e9c);
	}

	.hud-clock {
		margin-left: 0.9rem;
		color: #f0b90b;
		font-variant-numeric: tabular-nums;
	}

	.hud-foot {
		display: flex;
		flex-wrap: wrap;
		align-items: baseline;
		justify-content: space-between;
		gap: 0.3rem 1rem;
		margin-top: 0.9rem;
		padding-top: 0.75rem;
		border-top: 1px solid rgba(255, 255, 255, 0.08);
		transition: opacity 0.35s ease 0.08s;
	}

	.hud.swap .hud-foot {
		opacity: 0;
	}

	.hud-foot:has(.hud-stat:empty) {
		display: none;
	}

	.hud-stat {
		margin: 0;
		font-family: var(--font-display);
		font-weight: 700;
		font-size: 1.05rem;
		color: var(--layer, #eaecef);
	}

	.hud-term {
		margin: 0;
		font-family: var(--font-mono);
		font-size: 0.7rem;
		letter-spacing: 0.04em;
		color: #707a8a;
	}

	.hud-term span {
		color: #b7bdc6;
	}

	.hud-title {
		margin: 0;
		font-family: var(--font-display);
		font-size: clamp(1.4rem, 2.2vw, 1.85rem);
		font-weight: 700;
		letter-spacing: -0.02em;
		line-height: 1.15;
		color: #f5f6f7;
		transition: opacity 0.35s ease, transform 0.35s ease, filter 0.35s ease;
	}

	.hud-body {
		margin: 0.6rem 0 0;
		font-family: var(--font-display);
		font-size: 0.98rem;
		line-height: 1.55;
		color: #b7bdc6;
		transition: opacity 0.35s ease 0.05s, transform 0.35s ease 0.05s, filter 0.35s ease 0.05s;
	}

	/* ---------- Final choice ---------- */
	.choose {
		position: absolute;
		inset: 0;
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 23rem));
		justify-content: center;
		align-content: center;
		gap: clamp(1rem, 6vw, 7rem);
		padding: 6rem var(--gutter) 9rem;
		opacity: 0;
		visibility: hidden;
		transition: opacity 0.6s ease, visibility 0.6s;
	}

	.choose.on {
		opacity: 1;
		visibility: visible;
	}

	.door {
		--c: #f0b90b;
		position: relative;
		display: flex;
		flex-direction: column;
		gap: 0.7rem;
		padding: 1.6rem 1.6rem 1.5rem;
		border-radius: 18px;
		border: 1px solid color-mix(in srgb, var(--c) 35%, transparent);
		background: linear-gradient(165deg, color-mix(in srgb, var(--c) 14%, rgba(10, 12, 16, 0.75)), rgba(6, 8, 11, 0.7));
		-webkit-backdrop-filter: blur(10px);
		backdrop-filter: blur(10px);
		color: #eaecef;
		text-decoration: none;
		box-shadow: 0 0 0 0 color-mix(in srgb, var(--c) 40%, transparent), 0 40px 90px -40px color-mix(in srgb, var(--c) 70%, transparent);
		transform: translateY(24px) scale(0.97);
		transition: transform 0.6s cubic-bezier(0.22, 1, 0.36, 1), box-shadow 0.35s ease, border-color 0.35s ease;
	}

	.choose.on .door {
		transform: none;
	}

	.choose.on .door-agent {
		transition-delay: 0.08s;
	}

	.door-agent {
		--c: #0ecb81;
	}

	.door:hover,
	.door:focus-visible {
		border-color: var(--c);
		box-shadow: 0 0 0 1px var(--c), 0 40px 120px -30px color-mix(in srgb, var(--c) 90%, transparent);
		outline: none;
	}

	.door-tag {
		font-family: var(--font-mono);
		font-size: 0.72rem;
		letter-spacing: 0.2em;
		text-transform: uppercase;
		color: var(--c);
	}

	.door-name {
		font-family: var(--font-display);
		font-size: clamp(2rem, 3.6vw, 2.9rem);
		font-weight: 700;
		letter-spacing: -0.03em;
		line-height: 1;
	}

	.door-body {
		font-family: var(--font-display);
		font-size: 0.98rem;
		line-height: 1.5;
		color: #b7bdc6;
	}

	.door-go {
		margin-top: 0.6rem;
		font-family: var(--font-display);
		font-weight: 600;
		font-size: 0.95rem;
		color: var(--c);
	}

	.door-go b {
		display: inline-block;
		transition: transform 0.3s ease;
	}

	.door:hover .door-go b {
		transform: translateX(5px);
	}

	/* ---------- Progress rail ---------- */
	.rail {
		position: absolute;
		left: 50%;
		bottom: 2.2rem;
		width: min(64rem, calc(100vw - 2 * var(--gutter)));
		transform: translateX(-50%);
		opacity: 0;
		transition: opacity 0.5s ease;
	}

	.rail.on {
		opacity: 1;
	}

	.rail-line {
		position: absolute;
		left: calc(100% / (2 * var(--steps)));
		right: calc(100% / (2 * var(--steps)));
		top: 6px;
		height: 1px;
		background: rgba(255, 255, 255, 0.12);
	}

	.rail-fill {
		display: block;
		height: 100%;
		width: 0;
		background: linear-gradient(90deg, #0ecb81, #f0b90b);
		box-shadow: 0 0 12px rgba(240, 185, 11, 0.7);
	}

	.rail ol {
		position: relative;
		display: grid;
		grid-template-columns: repeat(var(--steps), 1fr);
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.rail button {
		--layer: #848e9c;
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 0.6rem;
		width: 100%;
		padding: 0;
		border: 0;
		background: none;
		cursor: pointer;
		color: #5e6673;
		font-family: var(--font-mono);
		font-size: 0.62rem;
		letter-spacing: 0.12em;
	}

	.dot {
		width: 13px;
		height: 13px;
		border-radius: 50%;
		border: 1px solid rgba(255, 255, 255, 0.22);
		background: #04060a;
		transition: background 0.3s ease, border-color 0.3s ease, box-shadow 0.3s ease, transform 0.3s ease;
	}

	.rail button.past .dot {
		background: var(--layer);
		border-color: var(--layer);
	}

	.rail button.now {
		color: #eaecef;
	}

	.rail button.now .dot {
		background: var(--layer);
		border-color: #fff;
		transform: scale(1.35);
		box-shadow: 0 0 0 5px color-mix(in srgb, var(--layer) 25%, transparent), 0 0 18px var(--layer);
	}

	.rail button:hover {
		color: #b7bdc6;
	}

	.rail button:focus-visible {
		outline: 2px solid #f0b90b;
		outline-offset: 4px;
		border-radius: 4px;
	}

	.l-user { --layer: #eaecef; }
	.l-infra { --layer: #f0b90b; }
	.l-agent { --layer: #0ecb81; }
	.l-model { --layer: #5ab8ff; }
	.l-you { --layer: #eaecef; }
	.l-all { --layer: #c9a7ff; }

	.skip {
		position: absolute;
		right: var(--gutter);
		top: 1.1rem;
		z-index: 2;
		padding: 0.3rem 0.7rem;
		border: 1px solid rgba(255, 255, 255, 0.14);
		border-radius: 999px;
		font-family: var(--font-mono);
		font-size: 0.72rem;
		letter-spacing: 0.12em;
		text-transform: uppercase;
		color: #848e9c;
		text-decoration: none;
		background: rgba(8, 10, 14, 0.5);
		-webkit-backdrop-filter: blur(6px);
		backdrop-filter: blur(6px);
