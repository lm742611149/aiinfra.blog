---
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { COURSE_SERIES, COURSE_TITLE, SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import { personSchema, websiteSchema } from '../lib/seo';

const days = (
	await getCollection('blog', ({ data }) => !data.draft && data.series === COURSE_SERIES && data.day !== undefined)
).sort((a, b) => a.data.day! - b.data.day!);
const href = (day: number) => {
	const d = days.find((x) => x.data.day === day);
	return d ? `/blog/${d.id}/` : '/course';
};

const WEEKS = [
	{ tag: 'W1', range: 'Day 1–7', start: 1, title: '大模型与 API', body: 'token 和上下文窗口、Python 速成、调通 DeepSeek/通义/Claude、提示词、结构化输出。', out: '命令行聊天机器人' },
	{ tag: 'W2', range: 'Day 8–14', start: 8, title: '工具调用与 Agent 循环', body: 'function calling、不用框架手写 Agent 循环、ReAct、工具设计、失败处理、五种 workflow 模式。', out: '能查天气、读文件、搜网页的 Agent' },
	{ tag: 'W3', range: 'Day 15–21', start: 15, title: '上下文工程与 RAG', body: 'embedding、切块、pgvector、混合检索与 rerank、RAG 评估、记忆。', out: '带引用的文档问答' },
	{ tag: 'W4', range: 'Day 22–28', start: 22, title: 'MCP、框架与多 Agent', body: 'MCP 协议和自己写 server、LangGraph、人工审批、多 Agent、框架横评。', out: '工单分流 Agent' },
	{ tag: 'W5', range: 'Day 29–35', start: 29, title: '评测与可观测', body: '错误分析、测试集、LLM-as-judge、轨迹评测、Langfuse tracing。', out: '评测集 + CI 回归门禁' },
	{ tag: 'W6', range: 'Day 36–42', start: 36, title: '生产化', body: 'FastAPI 流式服务、长任务可靠性、成本与延迟、prompt injection、沙箱、Docker 部署。', out: '公网可访问的 Agent 服务' },
	{ tag: 'W7–8', range: 'Day 43–54', start: 43, title: '毕业项目 SupportPilot', body: '从零做一个智能客服工单 Agent:知识库、业务工具、审批、评测、可观测、上线、包装。', out: '能放进简历的完整项目' },
	{ tag: 'W9', range: 'Day 55–60', start: 55, title: '第二作品与求职', body: '一天做出代码审查 Agent,写简历,刷面试题和系统设计,找渠道、谈薪资。', out: '简历 + 两个作品' },
];
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<BaseHead
			title={`${COURSE_TITLE} — ${SITE_TITLE}`}
			description={SITE_DESCRIPTION}
			schema={[websiteSchema(Astro.site), personSchema(Astro.site)]}
		/>
	</head>
	<body>
		<Header />
		<main>
			<section class="shell hero">
				<p class="label">agent-60</p>
				<h1>60 天,从写业务代码到做 AI Agent</h1>
				<p class="lede">
					给有编程经验的人准备的一门速成课。不讲模型训练,不推公式,只学招聘 JD 上真正要的东西:调大模型 API、
					设计工具、手写 Agent 循环、做 RAG、接 MCP、写评测、把 Agent 稳稳地放上线。
				</p>
				<p class="lede">
					每天一篇,文档、B 站视频、书和代码都放在一起。每天不限时,有空就往前推。走完 60 天,你手里会有一个完整的
					智能客服 Agent 项目、一个代码审查 Agent,还有一套面试能讲清楚的东西。
				</p>
				<div class="cta-row">
					<a class="cta" href={href(0)}>从 Day 0 开始 →</a>
					<a class="cta cta--ghost" href="/course">看完整目录</a>
					<a class="cta cta--ghost" href="/blog/agent-jd-report-2026-10/">880 条 JD 拆解</a>
				</div>
				<p class="byline">已发布 {days.length} / 61 篇 · 代码统一用 Python + OpenAI 兼容接口,国内直连 DeepSeek 就能跑</p>
			</section>

			<section class="shell weeks">
				<h2 class="section-title">九周怎么走</h2>
				<ol class="week-grid">
					{
						WEEKS.map((w) => (
							<li class="week">
								<a href={href(w.start)}>
									<p class="week-tag">
										<span>{w.tag}</span>
										<span>{w.range}</span>
									</p>
									<h3>{w.title}</h3>
									<p class="week-body">{w.body}</p>
									<p class="week-out">产出:{w.out}</p>
								</a>
							</li>
						))
					}
				</ol>
			</section>
		</main>
		<Footer />
	</body>
</html>

<style>
	.hero {
		padding-block: clamp(3rem, 8vw, 5.5rem) clamp(2rem, 5vw, 3rem);
		border-bottom: var(--rule-weight) solid var(--rule);
	}

	.hero .label {
		margin-bottom: 0.9rem;
	}

	h1 {
		font-size: clamp(1.9rem, 4.5vw, 2.9rem);
		letter-spacing: 0;
		margin-bottom: 1.25rem;
		max-width: 22ch;
	}

	.lede {
		font-size: 1.05rem;
		line-height: 1.85;
		color: var(--ink-soft);
		max-width: 40rem;
		margin: 0 0 1rem;
	}

	.cta-row {
		display: flex;
		flex-wrap: wrap;
		gap: 0.8rem;
		margin-top: 1.6rem;
	}

	.cta {
		display: inline-block;
		padding: 0.65rem 1.15rem;
		border: 1px solid var(--mem);
		border-radius: 4px;
		background: var(--mem);
		color: var(--paper);
		text-decoration: none;
		font-size: 0.95rem;
	}

	.cta:hover {
		opacity: 0.9;
	}

	.cta--ghost {
		background: transparent;
		color: var(--mem);
	}

	.byline {
		font-family: var(--font-mono);
		font-size: 0.76rem;
		line-height: 1.6;
		color: var(--ink-faint);
		margin: 1.6rem 0 0;
	}

	.weeks {
		padding-block: 2.5rem 3rem;
	}

	.section-title {
		font-family: var(--font-mono);
		font-weight: 500;
		font-size: 0.76rem;
		letter-spacing: 0.14em;
		color: var(--ink-faint);
		margin-bottom: 1.1rem;
	}

	.week-grid {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(15.5rem, 1fr));
		gap: 1rem;
	}

	.week a {
		display: block;
		height: 100%;
		padding: 1.1rem 1.2rem 1.2rem;
		background: var(--paper-raised);
		border: 1px solid var(--rule);
		border-radius: 4px;
		text-decoration: none;
		color: var(--ink);
	}

	.week a:hover {
		border-color: var(--mem);
	}

	.week-tag {
		display: flex;
		justify-content: space-between;
		font-family: var(--font-mono);
		font-size: 0.72rem;
		letter-spacing: 0.08em;
		color: var(--mem);
		margin: 0 0 0.55rem;
	}

	.week h3 {
		font-size: 1.12rem;
		letter-spacing: 0;
		margin: 0 0 0.5rem;
	}

	.week-body {
		font-size: 0.92rem;
		line-height: 1.75;
		color: var(--ink-soft);
		margin: 0 0 0.7rem;
	}

	.week-out {
		font-size: 0.85rem;
		color: var(--compute);
		margin: 0;
	}
</style>
