---
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { COURSE_SERIES, COURSE_TITLE, SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import { personSchema, websiteSchema } from '../lib/seo';

const days = (
	await getCollection('blog', ({ data }) => !data.draft && data.series === COURSE_SERIES && data.day !== undefined)
).sort((a, b) => a.data.day! - b.data.day!);
const href = (day: number) => {
	const d = days.find((x) => x.data.day === day);
	return d ? `/blog/${d.id}/` : '/course';
};

const ADV = [
	{ tag: 'W10', title: 'Agent 架构深水区', body: 'Harness 设计、长任务上下文、记忆系统、持久化执行、编排取舍', start: 61 },
	{ tag: 'W11', title: '评测科学', body: '样本量与显著性、大规模 LLM 评审、线上 A/B、自动化红队', start: 68 },
	{ tag: 'W12', title: '模型层', body: '选型、vLLM 自部署、LoRA 微调、DPO、蒸馏路由、RL 入门', start: 75 },
	{ tag: 'W13', title: '平台化与规模', body: '多租户平台、模型网关、MCP 鉴权、可观测、合规、事故复盘', start: 82 },
	{ tag: 'W14', title: '前沿形态', body: 'Coding Agent 内部、Computer Use、语音、Deep Research、A2A', start: 89 },
	{ tag: 'W15–16', title: '进阶毕业项目 AgentOps', body: '把 SupportPilot 升级成多租户 Agent 平台', start: 96 },
	{ tag: 'W17', title: '资深求职', body: '设计文档、Staff 系统设计面试、带人、开源影响力', start: 106 },
];

const WEEKS = [
	{ tag: 'W1', range: 'Day 1–7', start: 1, title: '大模型与 API', body: 'token 和上下文窗口、Python 速成、调通 DeepSeek / 通义 / Claude、提示词、结构化输出。', out: '命令行聊天机器人' },
	{ tag: 'W2', range: 'Day 8–14', start: 8, title: '工具调用与 Agent 循环', body: 'function calling、不用框架手写 Agent 循环、ReAct、工具设计、失败处理、五种 workflow 模式。', out: '会查天气、读文件、搜网页的 Agent' },
	{ tag: 'W3', range: 'Day 15–21', start: 15, title: '上下文工程与 RAG', body: 'embedding、切块、pgvector、混合检索与 rerank、RAG 评估、记忆和上下文压缩。', out: '带引用出处的文档问答' },
	{ tag: 'W4', range: 'Day 22–28', start: 22, title: 'MCP、框架与多 Agent', body: '自己写 MCP server、LangGraph、人工审批、多 Agent、Skills、框架横评。', out: '工单分流 Agent' },
	{ tag: 'W5', range: 'Day 29–35', start: 29, title: '评测与可观测', body: '错误分析、测试集、LLM-as-judge、轨迹评测、Langfuse 和 OpenTelemetry。', out: '评测集和 CI 回归门禁' },
	{ tag: 'W6', range: 'Day 36–42', start: 36, title: '生产化', body: 'FastAPI 流式服务、长任务、成本与 ROI、prompt injection、沙箱、Docker 部署。', out: '公网能访问的 Agent 服务' },
	{ tag: 'W7–8', range: 'Day 43–54', start: 43, title: '毕业项目 SupportPilot', body: '从零做一个智能客服工单 Agent:知识库、业务工具、审批、评测、成本、上线、包装。', out: '能放进简历的完整项目' },
	{ tag: 'W9', range: 'Day 55–60', start: 55, title: '第二个作品和求职', body: '一天做出代码审查 Agent,改简历,练面试题和系统设计,看渠道、谈薪资。', out: '简历和两个作品' },
];

// From docs/jd-research/summary.md (880 postings, 2026-10). Share of postings mentioning each skill.
const JD = [
	{ skill: '评测 / eval', cn: 48, os: 62, day: 29 },
	{ skill: '工具调用', cn: 55, os: 39, day: 8 },
	{ skill: '上下文工程', cn: 52, os: 25, day: 20 },
	{ skill: '多 Agent', cn: 37, os: 22, day: 26 },
	{ skill: 'MCP', cn: 17, os: 16, day: 22 },
];
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<BaseHead
			title={`${COURSE_TITLE} — ${SITE_TITLE}`}
			description={SITE_DESCRIPTION}
			schema={[websiteSchema(Astro.site), personSchema(Astro.site)]}
		/>
	</head>
	<body>
		<Header />
		<main>
			<section class="stage">
				<div class="shell stage-grid">
					<div class="pitch">
						<h1>60 天,<br />学会造一个<br />能干活的 Agent</h1>
						<p class="lede">
							演示里这个客服 Agent 是这门课的毕业项目。它会读工单、查账单、翻帮助中心,该找人审批的时候停下来等人。
							60 天后,这套东西你能从零写出来,也能在面试里讲清楚每一步为什么这么做。
						</p>
						<div class="actions">
							<a class="btn btn-primary" href={href(0)}>从 Day 0 开始学</a>
							<a class="btn btn-ghost" href="/course">看 61 篇目录</a>
						</div>
						<p class="fine">写给有编程经验的人。代码统一用 Python,国内直连 DeepSeek 就能跑,整门课 API 费用一两百块。</p>
					</div>

					<div class="console" aria-label="SupportPilot 处理一张退款工单的回放">
						<div class="console-bar">
							<span class="lights" aria-hidden="true"><i></i><i></i><i></i></span>
							<span class="console-title">supportpilot 回放:工单 T-1042</span>
							<span class="meter" aria-hidden="true">
								<span><b data-meter="steps">0</b> 步</span>
								<span><b data-meter="cost">¥0.000</b></span>
							</span>
						</div>
						<ol class="trace" data-trace>
							<li class="ln ln-user" data-step="0" data-cost="0">
								<span class="who">客户</span>
								<span class="msg">上个月年付被扣了两次 468 块,能退一笔吗?</span>
							</li>
							<li class="ln ln-think" data-step="1" data-cost="0.002">
								<span class="who">LLM</span>
								<span class="msg">分类 = 退款。先确认是不是重复扣款,再查退款政策。</span>
							</li>
							<li class="ln ln-call" data-step="2" data-cost="0.004">
								<span class="who">tool</span>
								<span class="msg"><em>list_invoices</em>(customer_id="C007", months=2)</span>
							</li>
							<li class="ln ln-obs" data-step="2" data-cost="0.004">
								<span class="who"></span>
								<span class="msg">INV-2290 ¥468 已付 09-03 · INV-2291 ¥468 已付 09-03</span>
							</li>
							<li class="ln ln-call" data-step="3" data-cost="0.007">
								<span class="who">tool</span>
								<span class="msg"><em>search_kb</em>(query="重复扣款 退款")</span>
							</li>
							<li class="ln ln-obs" data-step="3" data-cost="0.007">
								<span class="who"></span>
								<span class="msg">kb-002#3 重复扣款全额退回,3 个工作日到账</span>
							</li>
							<li class="ln ln-call" data-step="4" data-cost="0.010">
								<span class="who">tool</span>
								<span class="msg"><em>create_refund</em>(invoice="INV-2291", amount=468)</span>
							</li>
							<li class="ln ln-wait" data-step="4" data-cost="0.010" data-hold="1600">
								<span class="who">暂停</span>
								<span class="msg">写操作,等主管审批……</span>
							</li>
							<li class="ln ln-human" data-step="5" data-cost="0.010">
								<span class="who">主管</span>
								<span class="msg">批准</span>
							</li>
							<li class="ln ln-answer" data-step="6" data-cost="0.016">
								<span class="who">回复</span>
								<span class="msg">查到 9 月 3 日同一笔年费扣了两次,多扣的 468 元已提交退款,3 个工作日内原路退回。<cite>依据:帮助中心《退款政策》第 3 节</cite></span>
							</li>
						</ol>
						<p class="console-foot">示例回放。Day 9 写出这个循环的骨架,Day 25 加上审批暂停,Day 46 接上真实的业务工具。</p>
					</div>
				</div>
			</section>

			<section class="shell route">
				<div class="sec-head">
					<h2>九周,一条线走下来</h2>
					<p>每周的小项目都会留到下一周继续用,到第七周拼成毕业项目。</p>
				</div>
				<ol class="timeline">
					{
						WEEKS.map((w) => (
							<li class="tl-item">
								<a href={href(w.start)}>
									<span class="tl-tag">{w.tag}</span>
									<span class="tl-range">{w.range}</span>
									<span class="tl-title">{w.title}</span>
									<span class="tl-body">{w.body}</span>
									<span class="tl-out">做出来:{w.out}</span>
								</a>
							</li>
						))
					}
				</ol>
			</section>

			<section class="adv">
				<div class="shell adv-inner">
					<div class="adv-head">
						<p class="adv-tag">进阶篇 · Day 61–110</p>
						<h2>60 天之后,往资深走</h2>
						<p>
							基础篇让你拿到入场券。进阶篇对准国内 JD 里标题带「资深、专家、架构师」的那一档,挂牌年包中位 66 万。
							讲的是判断力和规模:为什么这样设计,十倍流量下还成不成立,怎么用数据说服别人。
						</p>
						<a class="btn btn-primary" href={href(61)}>看进阶篇第一课</a>
					</div>
					<ol class="adv-list">
						{ADV.map((a) => (
							<li>
								<a href={href(a.start)}>
									<span class="adv-w">{a.tag}</span>
									<span class="adv-t">{a.title}</span>
									<span class="adv-b">{a.body}</span>
								</a>
							</li>
						))}
					</ol>
				</div>
			</section>

			<section class="shell build">
				<div class="build-copy">
					<h2>毕业时,你的 GitHub 上会有这些</h2>
					<p>
						SupportPilot 是一个给虚构 SaaS 公司「云簿」做的客服工单 Agent。它不是 demo:有 100 条测试集和评测报告,有成本账本,
						有注入测试,部署在公网上,README 里有架构图和演示视频。招聘方看项目时想看的,基本都在里面。
					</p>
					<ul class="deliver">
						<li><b>能跑的仓库</b>LangGraph 编排,pgvector 知识库,MCP 业务工具</li>
						<li><b>评测报告</b>规则断言、LLM 评分、轨迹检查,每次改动有分数对比</li>
						<li><b>成本和延迟数据</b>单张工单花多少钱,和人工比划不划算</li>
						<li><b>第二个作品</b>代码审查 Agent,一天做出来</li>
					</ul>
					<a class="btn btn-ghost-ink" href={href(43)}>看毕业项目怎么开题</a>
				</div>
				<figure class="arch" aria-label="SupportPilot 架构">
					<svg viewBox="0 0 560 400" role="img">
						<title>SupportPilot 架构</title>
						<g class="a-edge">
							<path d="M 280 64 L 280 104"></path>
							<path d="M 280 176 L 280 214"></path>
							<path d="M 200 140 L 95 140 L 95 214"></path>
							<path d="M 360 140 L 465 140 L 465 214"></path>
							<path d="M 280 286 L 280 320"></path>
						</g>
						<g>
							<rect x="200" y="20" width="160" height="44" rx="8" class="a-plain"></rect>
							<text x="280" y="47" class="a-t">工单 / 多轮对话</text>
						</g>
						<g>
							<rect x="200" y="104" width="160" height="72" rx="8" class="a-mem"></rect>
							<text x="280" y="132" class="a-t a-strong">LangGraph 主流程</text>
							<text x="280" y="154" class="a-t a-soft">分类 检索 执行 自检</text>
						</g>
						<g>
							<rect x="20" y="214" width="150" height="72" rx="8" class="a-cmp"></rect>
							<text x="95" y="242" class="a-t a-strong">知识库 RAG</text>
							<text x="95" y="264" class="a-t a-soft">pgvector 混合检索</text>
						</g>
						<g>
							<rect x="205" y="214" width="150" height="72" rx="8" class="a-cmp"></rect>
							<text x="280" y="242" class="a-t a-strong">人工审批</text>
							<text x="280" y="264" class="a-t a-soft">写操作先停下</text>
						</g>
						<g>
							<rect x="390" y="214" width="150" height="72" rx="8" class="a-cmp"></rect>
							<text x="465" y="242" class="a-t a-strong">MCP 业务工具</text>
							<text x="465" y="264" class="a-t a-soft">账单 / 只读 SQL</text>
						</g>
						<g>
							<rect x="120" y="320" width="320" height="56" rx="8" class="a-plain a-dash"></rect>
							<text x="280" y="343" class="a-t a-strong">评测 + Langfuse 追踪 + 成本账本</text>
							<text x="280" y="363" class="a-t a-soft">每次改 prompt 都跑一遍回归</text>
						</g>
					</svg>
				</figure>
			</section>

			<section class="shell market">
				<div class="sec-head">
					<h2>招聘方到底要什么</h2>
					<p>
						2026 年 10 月抓了 880 条 AI Agent 工程师 JD,国内 695 条,海外 185 条。下面是几项技能在 JD 里出现的比例,每一项课程里都有对应的一天。
						国内挂牌年包中位数 48 万,明确要硕士的约一成。
					</p>
				</div>
				<div class="bars">
					<p class="legend"><span class="key key-cn"></span>国内 <span class="key key-os"></span>海外</p>
					{
						JD.map((r) => (
							<a class="bar-row" href={href(r.day)}>
								<span class="bar-skill">{r.skill}</span>
								<span class="bar-pair">
									<span class="bar bar-cn" style={`--v:${r.cn}`}><span>{r.cn}%</span></span>
									<span class="bar bar-os" style={`--v:${r.os}`}><span>{r.os}%</span></span>
								</span>
								<span class="bar-day">Day {r.day}</span>
							</a>
						))
					}
				</div>
				<a class="btn btn-ghost-ink" href="/blog/agent-jd-report-2026-10/">读完整的 880 条 JD 拆解</a>
			</section>

			<section class="shell closing">
				<p>今天就能开始。Day 0 讲清楚这个岗位做什么、要准备什么、两个月能做到哪一步。</p>
				<a class="btn btn-primary" href={href(0)}>打开 Day 0</a>
			</section>
		</main>
		<Footer />

		<script>
			const trace = document.querySelector<HTMLOListElement>('[data-trace]');
			const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
			if (trace) {
				const lines = [...trace.querySelectorAll<HTMLLIElement>('.ln')];
				const steps = document.querySelector<HTMLElement>('[data-meter="steps"]');
				const cost = document.querySelector<HTMLElement>('[data-meter="cost"]');
				const show = (li: HTMLLIElement) => {
					li.classList.add('on');
					if (steps) steps.textContent = li.dataset.step ?? '0';
					if (cost) cost.textContent = `¥${Number(li.dataset.cost ?? 0).toFixed(3)}`;
				};
				if (reduce) {
					lines.forEach(show);
				} else {
					trace.classList.add('animated');
					const sleep = (ms: number) => new Promise((r) => setTimeout(r, ms));
					const run = async () => {
						for (;;) {
							lines.forEach((l) => l.classList.remove('on'));
							await sleep(700);
							for (const li of lines) {
								show(li);
								await sleep(Number(li.dataset.hold ?? 0) + (li.classList.contains('ln-obs') ? 650 : 1050));
							}
							await sleep(5200);
						}
					};
					run();
				}
			}
		</script>
	</body>
</html>

<style>
	/* ---------- Stage: the one loud element. Always dark, in both themes. ---------- */
	.stage {
		--s-bg: #0b0e11;
		--s-raised: #181a20;
		--s-rule: #2b3139;
		--s-ink: #eaecef;
		--s-soft: #b7bdc6;
		--s-faint: #848e9c;
		--s-blue: #f0b90b;
		--s-amber: #0ecb81;
		--s-green: #0ecb81;
		position: relative;
		background:
			radial-gradient(circle at 1px 1px, var(--s-rule) 1px, transparent 0) 0 0 / 22px 22px,
			var(--s-bg);
		color: var(--s-ink);
		border-bottom: 1px solid var(--s-rule);
		overflow: hidden;
	}

	.stage::after {
		content: '';
		position: absolute;
		inset: auto 0 0 0;
		height: 120px;
		background: linear-gradient(to bottom, transparent, var(--s-bg));
		pointer-events: none;
	}

	.stage-grid {
		position: relative;
		z-index: 1;
		display: grid;
		grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
		gap: clamp(2rem, 5vw, 4rem);
		align-items: center;
		padding-block: clamp(3rem, 7vw, 5.5rem);
	}

	.pitch h1 {
		color: var(--s-ink);
		font-size: clamp(2.4rem, 5.4vw, 3.9rem);
		line-height: 1.08;
		letter-spacing: -0.01em;
		margin: 0 0 1.4rem;
	}

	.lede {
		color: var(--s-soft);
		font-size: 1.06rem;
		line-height: 1.9;
		margin: 0 0 1.8rem;
		max-width: 30rem;
	}

	.actions {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem;
	}

	.btn {
		display: inline-block;
		padding: 0.7rem 1.25rem;
		border-radius: 6px;
		font-family: var(--font-display);
		font-size: 0.98rem;
		font-weight: 600;
		text-decoration: none;
		border: 1px solid transparent;
	}

	.btn:focus-visible {
		outline: 2px solid var(--s-blue, var(--mem));
		outline-offset: 3px;
	}

	.stage .btn-primary {
		background: var(--s-blue);
		color: #0b0e11;
	}

	.stage .btn-primary:hover {
		background: #fcd535;
	}

	.btn-ghost {
		color: var(--s-ink);
		border-color: var(--s-rule);
	}

	.btn-ghost:hover {
		border-color: var(--s-soft);
	}

	.fine {
		color: var(--s-faint);
		font-size: 0.86rem;
		line-height: 1.7;
		margin: 1.4rem 0 0;
		max-width: 28rem;
	}

	/* ---------- The trace console ---------- */
	.console {
		background: var(--s-raised);
		border: 1px solid var(--s-rule);
		border-radius: 10px;
		box-shadow:
			0 0 0 1px rgba(240, 185, 11, 0.06),
			0 30px 80px -20px rgba(0, 0, 0, 0.6);
		font-family: var(--font-mono);
		min-width: 0;
	}

	.console-bar {
		display: flex;
		align-items: center;
		gap: 0.8rem;
		padding: 0.7rem 1rem;
		border-bottom: 1px solid var(--s-rule);
		font-size: 0.74rem;
		color: var(--s-faint);
	}

	.lights {
		display: inline-flex;
		gap: 6px;
	}

	.lights i {
		width: 9px;
		height: 9px;
		border-radius: 50%;
		background: var(--s-rule);
	}

	.console-title {
		flex: 1;
		white-space: nowrap;
		overflow: hidden;
		text-overflow: ellipsis;
	}

	.meter {
		display: inline-flex;
		gap: 0.9rem;
		color: var(--s-soft);
	}

	.meter b {
		color: var(--s-amber);
		font-weight: 500;
	}

	.trace {
		list-style: none;
		margin: 0;
		padding: 1rem 1rem 0.6rem;
		min-height: 27rem;
	}

	.ln {
		display: grid;
		grid-template-columns: 3.4rem 1fr;
		gap: 0.6rem;
		padding: 0.32rem 0;
		font-size: 0.8rem;
		line-height: 1.65;
	}

	.trace.animated .ln {
		opacity: 0;
		transform: translateY(4px);
		transition:
			opacity 0.35s ease,
			transform 0.35s ease;
	}

	.trace.animated .ln.on {
		opacity: 1;
		transform: none;
