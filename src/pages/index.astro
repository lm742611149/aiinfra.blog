---
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import PostRow from '../components/PostRow.astro';
import Roofline from '../components/Roofline.astro';
import { COURSE_SERIES, SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import { personSchema, websiteSchema } from '../lib/seo';

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

const recent = posts.slice(0, 5);
const hasMore = posts.length > recent.length;

const course = posts.filter((p) => p.data.series === COURSE_SERIES && p.data.day !== undefined);
const courseLatest = course.sort((a, b) => b.data.day! - a.data.day!)[0];
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead
			title={`${SITE_TITLE} — GPU inference performance & a 365-day AI Infra course`}
			description={SITE_DESCRIPTION}
			schema={[websiteSchema(Astro.site), personSchema(Astro.site)]}
		/>
	</head>
	<body>
		<Header />
		<main>
			<section class="shell hero">
				<div class="thesis">
					<p class="label">The premise</p>
					<h1>Most inference isn't compute-bound. It's waiting on memory.</h1>
					<p class="lede">
						A GPU only reaches its headline TFLOP/s when a kernel does enough arithmetic per byte it
						moves. Single-sequence decode does about one FLOP per byte — under 1&#8239;% of what an
						A100 needs to climb off the memory roof. Nearly every serving win starts there.
					</p>
					<p class="byline">
						Working notes on profiling, kernels, and inference engines — written in public, with
						numbers.
					</p>
				</div>
				<div class="plot">
					<Roofline />
				</div>
			</section>

			{
				courseLatest && (
					<section class="shell course">
						<a class="course-card" href="/course">
							<div>
								<p class="label">365-day study log</p>
								<h2>365 天 AI Infra 自学课程</h2>
								<p class="course-lede">
									从 transformer 零基础开始,每天一篇。已写到 Day {courseLatest.data.day}:
									{courseLatest.data.title.replace(/^Day \d+ · /, '')}
								</p>
							</div>
							<span class="course-cta">目录 →</span>
						</a>
					</section>
				)
			}

			<section class="shell writing">
				<div class="section-head">
					<h2>Writing</h2>
					{hasMore && <a class="all" href="/blog">All posts →</a>}
				</div>

				{
					recent.length === 0 ? (
						<p class="empty">
							First post is in progress. Subscribe to <a href="/rss.xml">the feed</a> to get it.
						</p>
					) : (
						recent.map((post) => (
							<PostRow
								href={`/blog/${post.id}/`}
								title={post.data.title}
								description={post.data.description}
								pubDate={post.data.pubDate}
								regime={post.data.regime}
								tags={post.data.tags}
							/>
						))
					)
				}
			</section>
		</main>
		<Footer />
	</body>
</html>

<style>
	.hero {
		display: grid;
		grid-template-columns: minmax(0, 1.02fr) minmax(0, 1fr);
		gap: clamp(2rem, 5vw, 4rem);
		align-items: center;
		padding-block: clamp(3rem, 8vw, 5.5rem) clamp(2.5rem, 6vw, 4rem);
	}

	.thesis .label {
		margin-bottom: 0.9rem;
	}

	h1 {
		margin-bottom: 1.25rem;
	}

	.lede {
		font-size: 1.06rem;
		color: var(--ink-soft);
		max-width: 30rem;
	}

	.byline {
		font-family: var(--font-mono);
		font-size: 0.78rem;
		line-height: 1.6;
		color: var(--ink-faint);
		max-width: 26rem;
		margin: 1.6rem 0 0;
		padding-top: 1.1rem;
		border-top: var(--rule-weight) solid var(--rule);
	}

	.course {
		padding-top: 0.5rem;
		padding-bottom: 2.5rem;
	}

	.course-card {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1.5rem;
		padding: 1.4rem 1.6rem;
		background: var(--paper-raised);
		border: var(--rule-weight) solid var(--rule);
		border-left: 3px solid var(--mem);
		border-radius: 4px;
		text-decoration: none;
		color: var(--ink);
	}

	.course-card:hover {
		border-color: var(--mem);
	}

	.course-card .label {
		margin-bottom: 0.4rem;
	}

	.course-card h2 {
		font-size: 1.25rem;
		margin-bottom: 0.4rem;
		letter-spacing: 0;
	}

	.course-lede {
		margin: 0;
		color: var(--ink-soft);
		font-size: 0.95rem;
		line-height: 1.7;
		max-width: 34rem;
	}

	.course-cta {
		flex: none;
		font-family: var(--font-mono);
		font-size: 0.74rem;
		letter-spacing: 0.1em;
		color: var(--mem);
	}

	.writing {
		padding-top: 1rem;
	}

	.section-head {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: 1rem;
		padding-bottom: 0.9rem;
		border-bottom: var(--rule-weight) solid var(--rule);
	}

	.section-head h2 {
		font-size: 1.1rem;
		letter-spacing: 0.02em;
	}

	.all {
		font-family: var(--font-mono);
		font-size: 0.72rem;
		letter-spacing: 0.1em;
		text-transform: uppercase;
		text-decoration: none;
		color: var(--ink-faint);
	}

	.all:hover {
		color: var(--mem);
	}

	.empty {
		padding-block: 2.5rem;
		color: var(--ink-soft);
	}

	@media (max-width: 820px) {
		.hero {
			grid-template-columns: 1fr;
			gap: 2.5rem;
		}

		.plot {
			order: 2;
		}
	}
</style>
