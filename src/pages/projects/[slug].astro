---
import { getCollection, render } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import { SITE_TITLE } from '../../consts';
import { breadcrumbSchema } from '../../lib/seo';

export async function getStaticPaths() {
	const all = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
	return all.map((project, i) => ({
		params: { slug: project.id },
		props: {
			project,
			prev: all[i - 1] ?? null,
			next: all[i + 1] ?? null,
			names: Object.fromEntries(all.map((p) => [p.id, p.data.name])),
		},
	}));
}

const { project, prev, next, names } = Astro.props;
const d = project.data;
const { Content, headings } = await render(project);
const toc = headings.filter((h) => h.depth === 2);
const subtitle = d.title.split(' · ').slice(1).join(' · ');

const schema = [
	{
		'@type': 'TechArticle',
		headline: d.title,
		description: d.tagline,
		inLanguage: 'zh-CN',
		url: new URL(`/projects/${project.id}/`, Astro.site).toString(),
		isPartOf: { '@id': new URL('/projects/#list', Astro.site).toString() },
	},
	breadcrumbSchema(Astro.site, [
		{ name: SITE_TITLE, path: '/' },
		{ name: '实战项目', path: '/projects/' },
		{ name: d.title, path: `/projects/${project.id}/` },
	]),
];
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<BaseHead title={`${d.title} — ${SITE_TITLE}`} description={`${d.tagline}。${d.summary}`} lang="zh" schema={schema} />
	</head>
	<body>
		<Header />
		<main>
			<header class="stage">
				<div class="shell stage-inner">
					<nav class="crumbs" aria-label="位置">
						<a href="/projects">实战项目</a>
						<span>/</span>
						<span>{d.name}</span>
					</nav>
					<div class="title-row">
						<p class="big-num" aria-hidden="true">{String(d.order).padStart(2, '0')}</p>
						<div>
							<h1>
								{d.name}
								<span class="sub">{subtitle}</span>
							</h1>
							<p class="tagline">{d.tagline}</p>
						</div>
					</div>

					<dl class="spec">
						<div>
							<dt>难度</dt>
							<dd>
								<span class="meter" aria-label={`难度 ${d.difficulty} / 5`}>
									{[1, 2, 3, 4, 5].map((i) => <i class:list={{ on: i <= d.difficulty }} />)}
								</span>
								<span class="level">{d.level}</span>
							</dd>
						</div>
						<div>
							<dt>时长</dt>
							<dd>{d.duration}</dd>
						</div>
						<div>
							<dt>花费</dt>
							<dd>{d.cost}{d.gpu && <span class="warn">要租 GPU</span>}</dd>
						</div>
						<div>
							<dt>对准岗位</dt>
							<dd>{d.targets.join(' · ')}</dd>
						</div>
						<div class="wide">
							<dt>外部认可</dt>
							<dd>{d.recognition}</dd>
						</div>
						<div class="wide">
							<dt>技术栈</dt>
							<dd class="stack">{d.stack.map((s) => <span>{s}</span>)}</dd>
						</div>
						{
							d.depends.length > 0 && (
								<div class="wide">
									<dt>先做</dt>
									<dd>
										{d.depends.map((id, i) => (
											<>
												{i > 0 && '、'}
												<a href={`/projects/${id}/`}>{names[id] ?? id}</a>
											</>
										))}
									</dd>
								</div>
							)
						}
					</dl>
					{
						d.tutorial && (
							<a class="tutorial" href={d.tutorial}>
								这个项目有逐日教程,从第一天开始跟着做 →
							</a>
						)
					}
				</div>
			</header>

			<div class="shell grid">
				<article class="body">
					<div class="prose">
						<Content />
					</div>

					<nav class="pager" aria-label="上一个和下一个项目">
						{
							prev ? (
								<a class="pager-link" href={`/projects/${prev.id}/`}>
									<span class="pager-label">上一个</span>
									<span class="pager-title">{prev.data.name}</span>
								</a>
							) : (
								<span />
							)
						}
						{
							next ? (
								<a class="pager-link pager-next" href={`/projects/${next.id}/`}>
									<span class="pager-label">下一个</span>
									<span class="pager-title">{next.data.name}</span>
								</a>
							) : (
								<span />
							)
						}
					</nav>
				</article>

				{
					toc.length > 1 && (
						<aside class="toc" aria-label="本页目录">
							<div class="toc-inner">
								<p class="toc-title">本页目录</p>
								<ol>
									{toc.map((h) => (
										<li>
											<a href={`#${h.slug}`}>{h.text}</a>
										</li>
									))}
								</ol>
								<a class="toc-back" href="/projects">全部实战项目</a>
							</div>
						</aside>
					)
				}
			</div>
		</main>
		<Footer />
	</body>
</html>

<style>
	.stage {
		--s-bg: #0b0e11;
		--s-rule: #2b3139;
		--s-ink: #eaecef;
		--s-soft: #b7bdc6;
		--s-faint: #848e9c;
		--s-accent: #f0b90b;
		background:
			radial-gradient(circle at 1px 1px, var(--s-rule) 1px, transparent 0) 0 0 / 22px 22px,
			var(--s-bg);
		color: var(--s-ink);
		border-bottom: 1px solid var(--s-rule);
	}

	.stage-inner {
		padding-block: clamp(2rem, 5vw, 3.2rem) clamp(1.8rem, 4vw, 2.6rem);
	}

	.crumbs {
		display: flex;
		gap: 0.5rem;
		font-size: 0.86rem;
		color: var(--s-faint);
		margin-bottom: 1.6rem;
	}

	.crumbs a {
		color: var(--s-soft);
		text-decoration: none;
	}

	.crumbs a:hover {
		color: var(--s-accent);
	}

	.title-row {
		display: grid;
		grid-template-columns: auto minmax(0, 1fr);
		gap: clamp(1.2rem, 3vw, 2.5rem);
		align-items: start;
	}

	.big-num {
		margin: 0;
		font-family: var(--font-display);
		font-size: clamp(4rem, 9vw, 6.5rem);
		font-weight: 800;
		line-height: 0.9;
		color: transparent;
		-webkit-text-stroke: 1.5px var(--s-accent);
	}

	h1 {
		color: var(--s-ink);
		font-size: clamp(2rem, 4.2vw, 3rem);
		line-height: 1.2;
		margin: 0.2rem 0 0.8rem;
		letter-spacing: 0;
		display: grid;
		gap: 0.3rem;
	}

	.sub {
		font-size: 0.55em;
		font-weight: 500;
		color: var(--s-soft);
	}

	.tagline {
		margin: 0;
		font-size: 1.05rem;
		line-height: 1.8;
		color: var(--s-soft);
		max-width: 46rem;
	}

	.spec {
		display: grid;
		grid-template-columns: repeat(4, minmax(0, 1fr));
		gap: 1rem 1.6rem;
		margin: 2rem 0 0;
		padding-top: 1.4rem;
		border-top: 1px solid var(--s-rule);
		font-size: 0.9rem;
	}

	.spec .wide {
		grid-column: 1 / -1;
	}

	.spec dt {
		font-size: 0.76rem;
		color: var(--s-faint);
		margin-bottom: 0.25rem;
	}

	.spec dd {
		margin: 0;
		color: var(--s-ink);
		line-height: 1.6;
	}

	.spec a {
		color: var(--s-accent);
	}

	.meter {
		display: inline-flex;
		gap: 3px;
		vertical-align: middle;
		margin-right: 0.5rem;
	}

	.meter i {
		width: 14px;
		height: 9px;
		border-radius: 2px;
		background: var(--s-rule);
	}

	.meter i.on {
		background: var(--s-accent);
	}

	.level,
	.warn {
		font-size: 0.78rem;
		padding: 0.08rem 0.5rem;
		border-radius: 999px;
		border: 1px solid var(--s-rule);
		color: var(--s-soft);
	}

	.warn {
		margin-left: 0.5rem;
		color: var(--s-accent);
		border-color: var(--s-accent);
	}

	.stack {
		display: flex;
		flex-wrap: wrap;
		gap: 0.4rem;
	}

	.stack span {
		font-family: var(--font-mono);
		font-size: 0.76rem;
		border: 1px solid var(--s-rule);
		border-radius: 4px;
		padding: 0.1rem 0.45rem;
		color: var(--s-soft);
	}

	.tutorial {
		display: inline-block;
		margin-top: 1.6rem;
		padding: 0.55rem 1rem;
		border-radius: 6px;
		background: var(--s-accent);
		color: #0b0e11;
		font-family: var(--font-display);
		font-size: 0.95rem;
		font-weight: 600;
		text-decoration: none;
	}

	.tutorial:hover {
		background: #fcd535;
	}

	.grid {
		display: grid;
		grid-template-columns: minmax(0, 1fr) 15rem;
		gap: clamp(2rem, 4vw, 3.5rem);
		align-items: start;
	}

	.grid:not(:has(.toc)) {
		grid-template-columns: minmax(0, 1fr);
	}

	.body .prose {
		max-width: none;
		padding-top: 2.4rem;
	}

	.toc {
		position: sticky;
		top: 4.6rem;
		padding-top: 2.4rem;
		max-height: calc(100vh - 6rem);
		overflow-y: auto;
	}

	.toc-inner {
		border-left: 1px solid var(--rule);
		padding-left: 1rem;
	}

	.toc-title {
		font-family: var(--font-display);
		font-weight: 600;
		font-size: 0.9rem;
		margin: 0 0 0.8rem;
	}

	.toc ol {
		list-style: none;
		margin: 0 0 1.4rem;
		padding: 0;
		display: grid;
		gap: 0.15rem;
	}

	.toc a {
		display: block;
		font-size: 0.86rem;
		line-height: 1.5;
		padding: 0.3rem 0;
		color: var(--ink-faint);
		text-decoration: none;
	}

	.toc a:hover {
		color: var(--ink);
	}

	.toc .toc-back {
		color: var(--mem);
	}

	.pager {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 1rem;
		margin: 3.5rem 0 4rem;
	}

	.pager-link {
		display: flex;
		flex-direction: column;
		gap: 0.3rem;
		padding: 1rem 1.2rem;
		border: 1px solid var(--rule);
		border-radius: 8px;
		background: var(--paper-raised);
		color: var(--ink);
		text-decoration: none;
	}

	.pager-link:hover {
		border-color: var(--mem);
	}

	.pager-next {
		text-align: right;
	}

	.pager-label {
		font-size: 0.8rem;
		color: var(--ink-faint);
	}

	.pager-title {
		font-family: var(--font-display);
		font-weight: 600;
	}

	@media (max-width: 1080px) {
		.grid {
			grid-template-columns: minmax(0, 1fr);
		}

		.toc {
			display: none;
		}
	}

	@media (max-width: 760px) {
		.spec {
			grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
		}
	}

	@media (max-width: 640px) {
		.title-row {
			grid-template-columns: minmax(0, 1fr);
			gap: 0.2rem;
		}

		.big-num {
			font-size: 3rem;
		}
	}
</style>
