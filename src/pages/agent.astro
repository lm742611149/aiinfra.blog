---
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { COURSE_SERIES, COURSE_TITLE, SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import { personSchema, websiteSchema } from '../lib/seo';

const days = (
	await getCollection('blog', ({ data }) => !data.draft && data.series === COURSE_SERIES && data.day !== undefined)
).sort((a, b) => a.data.day! - b.data.day!);
const href = (day: number) => {
	const d = days.find((x) => x.data.day === day);
	return d ? `/blog/${d.id}/` : '/course';
};

const ADV = [
	{ tag: 'W10', title: 'Agent 架构深水区', body: 'Harness 设计、长任务上下文、记忆系统、持久化执行、编排取舍', start: 61 },
	{ tag: 'W11', title: '评测科学', body: '样本量与显著性、大规模 LLM 评审、线上 A/B、自动化红队', start: 68 },
	{ tag: 'W12', title: '模型层', body: '选型、vLLM 自部署、LoRA 微调、DPO、蒸馏路由、RL 入门', start: 75 },
	{ tag: 'W13', title: '平台化与规模', body: '多租户平台、模型网关、MCP 鉴权、可观测、合规、事故复盘', start: 82 },
	{ tag: 'W14', title: '前沿形态', body: 'Coding Agent 内部、Computer Use、语音、Deep Research、A2A', start: 89 },
	{ tag: 'W15–16', title: '进阶毕业项目 AgentOps', body: '把 SupportPilot 升级成多租户 Agent 平台', start: 96 },
	{ tag: 'W17', title: '资深求职', body: '设计文档、Staff 系统设计面试、带人、开源影响力', start: 106 },
	{ tag: '专题', title: '2026 下半年补充', body: 'Skills、CodeAct、工具检索、GraphRAG、问数、生成式 UI、供应链安全、国内合规,跳着读', start: 131 },
];

const projectCount = (await getCollection('projects')).length;

const WEEKS = [
	{ tag: 'W1', layer: 'LLM 调用层', range: 'Day 1–7', start: 1, title: '大模型与 API', body: 'token 和上下文窗口、Python 速成、调通 DeepSeek / 通义 / Claude、提示词、结构化输出。', out: '命令行聊天机器人' },
	{ tag: 'W2', layer: '工具循环', range: 'Day 8–14', start: 8, title: '工具调用与 Agent 循环', body: 'function calling、不用框架手写 Agent 循环、ReAct、工具设计、失败处理、五种 workflow 模式。', out: '会查天气、读文件、搜网页的 Agent' },
	{ tag: 'W3', layer: '检索与记忆', range: 'Day 15–21', start: 15, title: '上下文工程与 RAG', body: 'embedding、切块、pgvector、混合检索与 rerank、RAG 评估、记忆和上下文压缩。', out: '带引用出处的文档问答' },
	{ tag: 'W4', layer: 'MCP + 编排', range: 'Day 22–28', start: 22, title: 'MCP、框架与多 Agent', body: '自己写 MCP server、LangGraph、人工审批、多 Agent、Skills、框架横评。', out: '工单分流 Agent' },
	{ tag: 'W5', layer: '评测与追踪', range: 'Day 29–35', start: 29, title: '评测与可观测', body: '错误分析、测试集、LLM-as-judge、轨迹评测、Langfuse 和 OpenTelemetry。', out: '评测集和 CI 回归门禁' },
	{ tag: 'W6', layer: '服务与部署', range: 'Day 36–42', start: 36, title: '生产化', body: 'FastAPI 流式服务、长任务、成本与 ROI、prompt injection、沙箱、Docker 部署。', out: '公网能访问的 Agent 服务' },
	{ tag: 'W7–8', layer: 'SupportPilot', range: 'Day 43–54', start: 43, title: '毕业项目 SupportPilot', body: '从零做一个智能客服工单 Agent:知识库、业务工具、审批、评测、成本、上线、包装。', out: '能放进简历的完整项目' },
	{ tag: 'W9', layer: '作品集 + 简历', range: 'Day 55–60', start: 55, title: '第二个作品和求职', body: '一天做出代码审查 Agent,改简历,练面试题和系统设计,看渠道、谈薪资。', out: '简历和两个作品' },
];

// From docs/jd-research/summary.md (880 postings, 2026-10). Share of postings mentioning each skill.
const JD = [
	{ skill: '评测 / eval', cn: 48, os: 62, day: 29 },
	{ skill: '工具调用', cn: 55, os: 39, day: 8 },
	{ skill: '上下文工程', cn: 52, os: 25, day: 20 },
	{ skill: '多 Agent', cn: 37, os: 22, day: 26 },
	{ skill: 'MCP', cn: 17, os: 16, day: 22 },
];
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<BaseHead
			title={`${COURSE_TITLE} — ${SITE_TITLE}`}
			description={SITE_DESCRIPTION}
			schema={[websiteSchema(Astro.site), personSchema(Astro.site)]}
		/>
	</head>
	<body>
		<Header />
		<main>
			<section class="stage">
				<div class="glow glow-a" aria-hidden="true"></div>
				<div class="glow glow-b" aria-hidden="true"></div>
				<div class="scan" aria-hidden="true"></div>
				<div class="shell stage-grid">
					<div class="pitch">
						<h1 class="hero-title"><span style="--k:0">60 天,</span><span style="--k:1">学会造一个</span><span style="--k:2">能干活的 <em class="shine">Agent</em></span></h1>
						<p class="lede">
							演示里这个客服 Agent 是这门课的毕业项目。它会读工单、查账单、翻帮助中心,该找人审批的时候停下来等人。
							60 天后,这套东西你能从零写出来,也能在面试里讲清楚每一步为什么这么做。
						</p>
						<div class="actions">
							<a class="btn btn-primary" href={href(0)}>从 Day 0 开始学</a>
							<a class="btn btn-ghost" href="/course">看 {days.length} 篇目录</a>
						</div>
						<p class="fine">写给有编程经验的人。代码统一用 Python,国内直连 DeepSeek 就能跑,整门课 API 费用一两百块。</p>
						<dl class="stats">
							<div><dt>篇课程</dt><dd data-count={days.length}>{days.length}</dd></div>
							<div><dt>个实战项目</dt><dd data-count={projectCount}>{projectCount}</dd></div>
							<div><dt>个毕业项目</dt><dd data-count="2">2</dd></div>
						</dl>
					</div>

					<div class="console" aria-label="SupportPilot 处理一张退款工单的回放">
						<div class="console-bar">
							<span class="lights" aria-hidden="true"><i></i><i></i><i></i></span>
							<span class="console-title">supportpilot 回放:工单 T-1042</span>
							<span class="meter" aria-hidden="true">
								<span><b data-meter="steps">0</b> 步</span>
								<span><b data-meter="cost">¥0.000</b></span>
							</span>
						</div>
						<ol class="trace" data-trace>
							<li class="ln ln-user" data-step="0" data-cost="0">
								<span class="who">客户</span>
								<span class="msg">上个月年付被扣了两次 468 块,能退一笔吗?</span>
							</li>
							<li class="ln ln-think" data-step="1" data-cost="0.002">
								<span class="who">LLM</span>
								<span class="msg">分类 = 退款。先确认是不是重复扣款,再查退款政策。</span>
							</li>
							<li class="ln ln-call" data-step="2" data-cost="0.004">
								<span class="who">tool</span>
								<span class="msg"><em>list_invoices</em>(customer_id="C007", months=2)</span>
							</li>
							<li class="ln ln-obs" data-step="2" data-cost="0.004">
								<span class="who"></span>
								<span class="msg">INV-2290 ¥468 已付 09-03 · INV-2291 ¥468 已付 09-03</span>
							</li>
							<li class="ln ln-call" data-step="3" data-cost="0.007">
								<span class="who">tool</span>
								<span class="msg"><em>search_kb</em>(query="重复扣款 退款")</span>
							</li>
							<li class="ln ln-obs" data-step="3" data-cost="0.007">
								<span class="who"></span>
								<span class="msg">kb-002#3 重复扣款全额退回,3 个工作日到账</span>
							</li>
							<li class="ln ln-call" data-step="4" data-cost="0.010">
								<span class="who">tool</span>
								<span class="msg"><em>create_refund</em>(invoice="INV-2291", amount=468)</span>
							</li>
							<li class="ln ln-wait" data-step="4" data-cost="0.010" data-hold="1600">
								<span class="who">暂停</span>
								<span class="msg">写操作,等主管审批……</span>
							</li>
							<li class="ln ln-human" data-step="5" data-cost="0.010">
								<span class="who">主管</span>
								<span class="msg">批准</span>
							</li>
							<li class="ln ln-answer" data-step="6" data-cost="0.016">
								<span class="who">回复</span>
								<span class="msg">查到 9 月 3 日同一笔年费扣了两次,多扣的 468 元已提交退款,3 个工作日内原路退回。<cite>依据:帮助中心《退款政策》第 3 节</cite></span>
							</li>
						</ol>
						<p class="console-foot">示例回放。Day 9 写出这个循环的骨架,Day 25 加上审批暂停,Day 46 接上真实的业务工具。</p>
					</div>
				</div>
			</section>

			<section class="line" data-line>
				<div class="shell">
					<div class="sec-head" data-reveal>
						<p class="eyebrow">基础篇 · Day 1–60</p>
						<h2>九周,一条线走下来</h2>
						<p>第一周写出的命令行聊天机器人不会被扔掉。它每周长出一层新能力,第七周拼成毕业项目。往下滚,看它一层一层长出来。</p>
					</div>
					<div class="line-grid">
						<aside class="stack-wrap" aria-hidden="true">
							<div class="stack">
								<div class="stack-bar">
									<span class="lights"><i></i><i></i><i></i></span>
									<span>your-agent/</span>
									<span class="stack-week" data-stack-week>W0</span>
								</div>
								<ol class="layers">
									{
										WEEKS.map((w, i) => (
											<li class="layer" data-layer={i} style={`--i:${i}`}>
												<span class="layer-tag">{w.tag}</span>
												<span class="layer-name">{w.layer}</span>
											</li>
										))
									}
								</ol>
								<div class="stack-foot">
									<span>已就位 <b data-stack-count>0</b> / {WEEKS.length} 层</span>
									<span class="stack-gauge"><span data-stack-gauge></span></span>
								</div>
							</div>
						</aside>
						<ol class="stations" data-stations>
							<li class="spine" aria-hidden="true"><span data-spine></span></li>
							{
								WEEKS.map((w, i) => (
									<li class:list={['station', { capstone: w.tag === 'W7–8' }]} data-station={i}>
										<span class="node" aria-hidden="true"><span>{i + 1}</span></span>
										<a class="st-card" href={href(w.start)}>
											<span class="st-meta">
												<span class="st-tag">{w.tag}</span>
												<span class="st-range">{w.range}</span>
											</span>
											<span class="st-title">{w.title}</span>
											<span class="st-body">{w.body}</span>
											<span class="st-out"><i>+</i>{w.out}</span>
										</a>
									</li>
								))
							}
						</ol>
					</div>
				</div>
			</section>

			<section class="adv">
				<div class="shell adv-inner">
					<div class="adv-head" data-reveal>
						<p class="adv-tag">进阶篇 · Day 61–110</p>
						<h2>60 天之后,往资深走</h2>
						<p>
							基础篇让你拿到入场券。进阶篇对准国内 JD 里标题带「资深、专家、架构师」的那一档,挂牌年包中位 66 万。
							讲的是判断力和规模:为什么这样设计,十倍流量下还成不成立,怎么用数据说服别人。
						</p>
						<a class="btn btn-primary" href={href(61)}>看进阶篇第一课</a>
					</div>
					<ol class="adv-list" data-reveal data-stagger>
						{ADV.map((a) => (
							<li>
								<a href={href(a.start)}>
									<span class="adv-w">{a.tag}</span>
									<span class="adv-t">{a.title}</span>
									<span class="adv-b">{a.body}</span>
								</a>
							</li>
						))}
					</ol>
				</div>
			</section>

			<section class="shell build">
				<div class="build-copy" data-reveal>
					<p class="eyebrow">第 60 天</p>
					<h2>毕业时,你的 GitHub 上会有这些</h2>
					<p>
						SupportPilot 是给虚构 SaaS 公司「云簿」做的客服工单 Agent。它不是 demo:有 100 条测试集和评测报告,有成本账本,有注入测试,
						部署在公网上,README 里有架构图和演示视频。招聘方点开仓库想看的,基本都在里面。
					</p>
					<ul class="deliver">
						<li><b>能跑的仓库</b>LangGraph 编排,pgvector 知识库,MCP 业务工具</li>
						<li><b>评测报告</b>规则断言、LLM 评分、轨迹检查,每次改动有分数对比</li>
						<li><b>成本和延迟数据</b>单张工单花多少钱,和人工比划不划算</li>
						<li><b>第二个作品</b>代码审查 Agent,一天做出来</li>
					</ul>
					<a class="btn btn-ghost-ink" href={href(43)}>看毕业项目怎么开题</a>
				</div>

				<div class="repo" data-repo aria-label="毕业时 SupportPilot 仓库的示意">
					<div class="repo-top">
						<svg class="repo-icon" viewBox="0 0 16 16" aria-hidden="true"><path d="M2 2.5A2.5 2.5 0 0 1 4.5 0h8.75a.75.75 0 0 1 .75.75v12.5a.75.75 0 0 1-.75.75h-2.5a.75.75 0 0 1 0-1.5h1.75v-2h-8a1 1 0 0 0-.71 1.71.75.75 0 1 1-1.06 1.06A2.5 2.5 0 0 1 2 11.5Zm10.5-1h-8a1 1 0 0 0-1 1v6.71A2.5 2.5 0 0 1 4.5 9h8Z"></path></svg>
						<span class="repo-path"><span>you</span> / <b>supportpilot</b></span>
						<span class="pill">Public</span>
						<span class="repo-star">★ Star</span>
					</div>
					<div class="repo-tabs">
						<span class="on">Code</span>
						<span>Actions <i class="dot-ok" data-ci-dot></i></span>
						<span>Releases <em>v1.0</em></span>
					</div>
					<div class="repo-commit">
						<span class="avatar" aria-hidden="true"></span>
						<span class="cm-msg"><span data-typed>Day 54: README、架构图、演示视频</span><span class="caret" aria-hidden="true"></span></span>
						<span class="cm-count">60 commits</span>
					</div>
					<ul class="files">
						<li data-row><span class="f-ico dir"></span><span class="f-name">agent/</span><span class="f-msg">LangGraph:分类 检索 执行 自检</span><span class="f-day">Day 47</span></li>
						<li data-row><span class="f-ico dir"></span><span class="f-name">knowledge/</span><span class="f-msg">切块、混合检索、引用出处</span><span class="f-day">Day 45</span></li>
						<li data-row><span class="f-ico dir"></span><span class="f-name">mcp_tools/</span><span class="f-msg">订单、账单 MCP server,退款审批</span><span class="f-day">Day 46</span></li>
						<li data-row><span class="f-ico dir"></span><span class="f-name">web/</span><span class="f-msg">Next.js 工作台,流式展示工具调用</span><span class="f-day">Day 49</span></li>
						<li data-row><span class="f-ico dir"></span><span class="f-name">evals/</span><span class="f-msg">100 条测试集、LLM-judge、轨迹评测</span><span class="f-day">Day 50</span></li>
						<li data-row><span class="f-ico dir"></span><span class="f-name">deploy/</span><span class="f-msg">注入测试、权限、Docker 部署</span><span class="f-day">Day 53</span></li>
						<li data-row><span class="f-ico file"></span><span class="f-name">README.md</span><span class="f-msg">架构图、演示视频、评测报告</span><span class="f-day">Day 54</span></li>
					</ul>
					<div class="checks">
						<p class="checks-title">CI · 每次 push 都跑</p>
						<p class="check" data-check-row><span class="ci-state"></span>evals / 100 条回归测试</p>
						<p class="check" data-check-row><span class="ci-state"></span>security / prompt injection 用例</p>
						<p class="check" data-check-row><span class="ci-state"></span>deploy / docker build + 冒烟测试</p>
					</div>
				</div>
			</section>

			<section class="shell pinned" data-reveal>
				<div class="contrib">
					<div class="contrib-head">
						<p class="contrib-title">Day 0 → Day 60,每天至少一次提交</p>
						<p class="contrib-legend">少<i class="lv1"></i><i class="lv2"></i><i class="lv3"></i><i class="lv4"></i>多</p>
					</div>
					<div class="cells" data-cells aria-hidden="true">
						{Array.from({ length: 63 }, (_, i) => <i class={`lv${i > 60 ? 0 : ((i * 7 + (i % 5) * 3) % 4) + 1}`} style={`--d:${i}`} />)}
					</div>
				</div>
				<div class="pins">
					<p class="pins-title">之后还会多出这些</p>
					<ol>
						<li><a href={href(55)}><b>code-review-agent</b><span>Day 55 · 一天做出的第二作品</span><i class="lang py">Python</i></a></li>
						<li><a href={href(96)}><b>agentops</b><span>Day 96–105 · 多租户 Agent 平台</span><i class="lang py">Python</i></a></li>
						<li><a href="/projects/agent-loupe/"><b>agent-loupe</b><span>实战项目 · Agent 调试器</span><i class="lang ts">TypeScript</i></a></li>
						<li><a href="/projects/"><b>还有 {projectCount - 1} 个实战项目</b><span>浏览器 Agent、代码 Agent、防火墙、RL……</span><i class="lang more">挑两三个</i></a></li>
					</ol>
				</div>
			</section>

			<section class="shell market">
				<div class="sec-head" data-reveal>
					<h2>招聘方到底要什么</h2>
					<p>
						2026 年 10 月抓了 880 条 AI Agent 工程师 JD,国内 695 条,海外 185 条。下面是几项技能在 JD 里出现的比例,每一项课程里都有对应的一天。
						国内挂牌年包中位数 48 万,明确要硕士的约一成。
					</p>
				</div>
				<div class="bars" data-reveal data-bars>
					<p class="legend"><span class="key key-cn"></span>国内 <span class="key key-os"></span>海外</p>
					{
						JD.map((r) => (
							<a class="bar-row" href={href(r.day)}>
								<span class="bar-skill">{r.skill}</span>
								<span class="bar-pair">
									<span class="bar bar-cn" style={`--v:${r.cn}`}><span>{r.cn}%</span></span>
									<span class="bar bar-os" style={`--v:${r.os}`}><span>{r.os}%</span></span>
								</span>
								<span class="bar-day">Day {r.day}</span>
							</a>
						))
					}
				</div>
				<a class="btn btn-ghost-ink" href="/blog/agent-jd-report-2026-10/">读完整的 880 条 JD 拆解</a>
			</section>

			<section class="shell closing" data-reveal>
				<p>今天就能开始。Day 0 讲清楚这个岗位做什么、要准备什么、两个月能做到哪一步。</p>
				<a class="btn btn-primary" href={href(0)}>打开 Day 0</a>
			</section>
		</main>
		<Footer />

		<script>
			const trace = document.querySelector<HTMLOListElement>('[data-trace]');
			const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
			if (trace) {
				const lines = [...trace.querySelectorAll<HTMLLIElement>('.ln')];
				const steps = document.querySelector<HTMLElement>('[data-meter="steps"]');
				const cost = document.querySelector<HTMLElement>('[data-meter="cost"]');
				const show = (li: HTMLLIElement) => {
					li.classList.add('on');
					if (steps) steps.textContent = li.dataset.step ?? '0';
					if (cost) cost.textContent = `¥${Number(li.dataset.cost ?? 0).toFixed(3)}`;
				};
				if (reduce) {
					lines.forEach(show);
				} else {
					trace.classList.add('animated');
					const sleep = (ms: number) => new Promise((r) => setTimeout(r, ms));
					const run = async () => {
						for (;;) {
							lines.forEach((l) => l.classList.remove('on'));
							await sleep(700);
							for (const li of lines) {
								show(li);
								await sleep(Number(li.dataset.hold ?? 0) + (li.classList.contains('ln-obs') ? 650 : 1050));
							}
							await sleep(5200);
						}
					};
					run();
				}
			}
		</script>
		<script>
			const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
			document.documentElement.classList.add('js-motion');

			// Fade-up on first sight. Without IntersectionObserver or with reduced motion, everything just shows.
			const revealEls = [...document.querySelectorAll<HTMLElement>('[data-reveal]')];
			const onSeen = (el: Element, cb: () => void, margin = '0px 0px -12% 0px') => {
				if (reduceMotion || !('IntersectionObserver' in window)) return cb();
				const io = new IntersectionObserver(
					(entries) => {
						if (entries.some((e) => e.isIntersecting)) {
							io.disconnect();
							cb();
						}
					},
					{ rootMargin: margin },
				);
				io.observe(el);
			};
			revealEls.forEach((el) => onSeen(el, () => el.classList.add('in')));

			// Hero counters.
			document.querySelectorAll<HTMLElement>('[data-count]').forEach((el) => {
				const to = Number(el.dataset.count);
				if (reduceMotion || !to) return;
				const t0 = performance.now();
				const tick = (t: number) => {
					const k = Math.min(1, (t - t0) / 1400);
					el.textContent = String(Math.round(to * (1 - Math.pow(1 - k, 3))));
					if (k < 1) requestAnimationFrame(tick);
				};
				el.textContent = '0';
				setTimeout(() => requestAnimationFrame(tick), 500);
			});

			// The build line: the spine fills with scroll, and each week drops one layer onto the stack.
			const line = document.querySelector<HTMLElement>('[data-line]');
			if (line) {
				const list = line.querySelector<HTMLElement>('[data-stations]')!;
				const spine = line.querySelector<HTMLElement>('[data-spine]')!;
				const stations = [...line.querySelectorAll<HTMLElement>('[data-station]')];
				const layers = [...line.querySelectorAll<HTMLElement>('[data-layer]')];
				const week = line.querySelector<HTMLElement>('[data-stack-week]');
				const count = line.querySelector<HTMLElement>('[data-stack-count]');
				const gauge = line.querySelector<HTMLElement>('[data-stack-gauge]');
				let shown = -2;
				const setActive = (n: number) => {
					if (n === shown) return;
					shown = n;
					stations.forEach((st, i) => st.classList.toggle('lit', i <= n));
					layers.forEach((l, i) => l.classList.toggle('on', i <= n));
					layers.forEach((l, i) => l.classList.toggle('top', i === n));
					if (week) week.textContent = n >= 0 ? stations[n].querySelector('.st-tag')!.textContent! : 'W0';
					if (count) count.textContent = String(n + 1);
					if (gauge) gauge.style.transform = `scaleX(${(n + 1) / layers.length})`;
				};
				if (reduceMotion) {
					spine.style.transform = 'scaleY(1)';
					setActive(stations.length - 1);
				} else {
					line.classList.add('animated');
					let ticking = false;
					const update = () => {
						ticking = false;
						const mid = window.innerHeight * 0.55;
						const r = list.getBoundingClientRect();
						const p = Math.min(1, Math.max(0, (mid - r.top) / r.height));
						spine.style.transform = `scaleY(${p})`;
						let n = -1;
						stations.forEach((st, i) => {
							if (st.getBoundingClientRect().top < mid) n = i;
						});
						setActive(n);
					};
					addEventListener('scroll', () => {
						if (!ticking) {
							ticking = true;
							requestAnimationFrame(update);
						}
					}, { passive: true });
					addEventListener('resize', update);
					update();
				}
			}

			// The repo window: typed commit, files appear, CI checks go from running to passed. Loops while visible.
			const repo = document.querySelector<HTMLElement>('[data-repo]');
			if (repo) {
				const rows = [...repo.querySelectorAll<HTMLElement>('[data-row]')];
				const checks = [...repo.querySelectorAll<HTMLElement>('[data-check-row]')];
				const typed = repo.querySelector<HTMLElement>('[data-typed]');
				const dot = repo.querySelector<HTMLElement>('[data-ci-dot]');
				const full = typed?.textContent ?? '';
				const finish = () => {
					rows.forEach((r) => r.classList.add('on'));
					checks.forEach((c) => c.classList.add('pass'));
					dot?.classList.add('pass');
				};
				if (reduceMotion) {
					finish();
				} else {
					repo.classList.add('animated');
					const sleep = (ms: number) => new Promise((r) => setTimeout(r, ms));
					const play = async () => {
						for (;;) {
							rows.forEach((r) => r.classList.remove('on'));
							checks.forEach((c) => c.classList.remove('run', 'pass'));
							dot?.classList.remove('pass');
							if (typed) typed.textContent = '';
							await sleep(400);
							for (let i = 1; i <= full.length; i++) {
								if (typed) typed.textContent = full.slice(0, i);
								await sleep(45);
							}
							for (const r of rows) {
								r.classList.add('on');
								await sleep(170);
							}
							for (const c of checks) {
								c.classList.add('run');
								await sleep(900);
								c.classList.remove('run');
								c.classList.add('pass');
							}
							dot?.classList.add('pass');
							await sleep(6000);
						}
					};
					onSeen(repo, play, '0px 0px -20% 0px');
				}
			}

			const cells = document.querySelector<HTMLElement>('[data-cells]');
			if (cells) onSeen(cells, () => cells.classList.add('in'));
		</script>
	</body>
</html>

