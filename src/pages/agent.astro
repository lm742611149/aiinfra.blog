	@keyframes shine {
		0%,
		100% {
			background-position: 100% 0;
		}
		50% {
			background-position: 0 0;
		}
	}

	.pitch .lede,
	.pitch .actions,
	.pitch .fine,
	.stats {
		animation: rise 0.8s cubic-bezier(0.2, 0.7, 0.2, 1) 0.5s both;
	}

	.console {
		animation: float-in 1s cubic-bezier(0.2, 0.7, 0.2, 1) 0.3s both;
	}

	@keyframes float-in {
		from {
			opacity: 0;
			transform: perspective(1200px) rotateY(-10deg) translateX(30px);
		}
	}

	.stats {
		display: flex;
		gap: 2rem;
		margin: 1.8rem 0 0;
	}

	.stats div {
		display: flex;
		flex-direction: column-reverse;
	}

	.stats dd {
		margin: 0;
		font-family: var(--font-display);
		font-weight: 800;
		font-size: 2rem;
		line-height: 1.1;
		color: var(--s-ink);
		font-variant-numeric: tabular-nums;
	}

	.stats dt {
		font-size: 0.8rem;
		color: var(--s-faint);
	}

	.eyebrow {
		margin: 0 0 0.6rem;
		font-family: var(--font-mono);
		font-size: 0.78rem;
		letter-spacing: 0.06em;
		color: var(--mem);
	}

	/* ---------- Reveal on scroll ---------- */
	:global(.js-motion) [data-reveal]:not(.in) {
		opacity: 0;
		transform: translateY(28px);
	}

	[data-reveal] {
		transition:
			opacity 0.8s cubic-bezier(0.2, 0.7, 0.2, 1),
			transform 0.8s cubic-bezier(0.2, 0.7, 0.2, 1);
	}

	:global(.js-motion) [data-stagger]:not(.in) > li {
		opacity: 0;
		transform: translateX(24px);
	}

	[data-stagger] > li {
		transition:
			opacity 0.6s ease,
			transform 0.6s cubic-bezier(0.2, 0.7, 0.2, 1);
	}

	[data-stagger] > li:nth-child(2) { transition-delay: 0.07s; }
	[data-stagger] > li:nth-child(3) { transition-delay: 0.14s; }
	[data-stagger] > li:nth-child(4) { transition-delay: 0.21s; }
	[data-stagger] > li:nth-child(5) { transition-delay: 0.28s; }
	[data-stagger] > li:nth-child(6) { transition-delay: 0.35s; }
	[data-stagger] > li:nth-child(7) { transition-delay: 0.42s; }

	:global(.js-motion) [data-bars]:not(.in) .bar {
		transform: scaleX(0);
	}

	.bar {
		transform-origin: 0 50%;
		transition: transform 1.1s cubic-bezier(0.2, 0.7, 0.2, 1);
	}

	.bar-os {
		transition-delay: 0.15s;
	}

	/* ---------- The build line ---------- */
	.line {
		padding-block: clamp(3rem, 7vw, 5rem);
	}

	.line-grid {
		display: grid;
		grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);
		gap: clamp(2rem, 5vw, 4.5rem);
		align-items: start;
	}

	.stack-wrap {
		position: sticky;
		top: 6rem;
	}

	.stack {
		background: #0b0e11;
		border: 1px solid #2b3139;
		border-radius: 12px;
		color: #eaecef;
		font-family: var(--font-mono);
		box-shadow: 0 30px 70px -30px rgba(0, 0, 0, 0.55);
		overflow: hidden;
	}

	.stack-bar {
		display: flex;
		align-items: center;
		gap: 0.8rem;
		padding: 0.7rem 1rem;
		border-bottom: 1px solid #2b3139;
		font-size: 0.76rem;
		color: #848e9c;
	}

	.stack-bar .lights i {
		background: #2b3139;
	}

	.stack-week {
		margin-left: auto;
		color: #f0b90b;
		font-weight: 600;
	}

	.layers {
		list-style: none;
		margin: 0;
		padding: 1.1rem 1.1rem 0.6rem;
		display: flex;
		flex-direction: column-reverse;
		gap: 0.45rem;
		background:
			radial-gradient(circle at 1px 1px, #1e2329 1px, transparent 0) 0 0 / 16px 16px;
	}

	.layer {
		display: flex;
		align-items: center;
		gap: 0.8rem;
		padding: 0.62rem 0.85rem;
		border: 1px dashed #2b3139;
		border-radius: 7px;
		font-size: 0.8rem;
		color: #474d57;
		transition:
			background 0.45s ease,
			border-color 0.45s ease,
			color 0.45s ease,
			box-shadow 0.45s ease,
			transform 0.45s cubic-bezier(0.3, 1.4, 0.5, 1);
	}

	.layer-tag {
		width: 2.6rem;
		flex: none;
		font-weight: 700;
	}

	.layer.on {
		border-style: solid;
		border-color: color-mix(in srgb, #f0b90b 45%, #2b3139);
		background: linear-gradient(90deg, rgba(240, 185, 11, 0.14), rgba(240, 185, 11, 0.03));
		color: #eaecef;
	}

	.layer.on .layer-tag {
		color: #f0b90b;
	}

	.layer[data-layer='6'].on {
		border-color: #0ecb81;
		background: linear-gradient(90deg, rgba(14, 203, 129, 0.2), rgba(14, 203, 129, 0.04));
	}

	.layer[data-layer='6'].on .layer-tag {
		color: #0ecb81;
	}

	.layer.top {
		box-shadow: 0 0 0 1px rgba(240, 185, 11, 0.35), 0 0 26px -4px rgba(240, 185, 11, 0.45);
		animation: drop 0.55s cubic-bezier(0.3, 1.4, 0.5, 1);
	}

	@keyframes drop {
		from {
			transform: translateY(-22px);
			opacity: 0.2;
		}
	}

	.stack-foot {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		padding: 0.75rem 1rem 0.9rem;
		font-size: 0.74rem;
		color: #848e9c;
	}

	.stack-foot b {
		color: #0ecb81;
		font-weight: 600;
	}

	.stack-gauge {
		flex: 1;
		max-width: 10rem;
		height: 4px;
		border-radius: 2px;
		background: #2b3139;
		overflow: hidden;
	}

	.stack-gauge span {
		display: block;
		height: 100%;
		background: linear-gradient(90deg, #f0b90b, #0ecb81);
		transform: scaleX(0);
		transform-origin: 0 50%;
		transition: transform 0.5s ease;
	}

	.stations {
		list-style: none;
		margin: 0;
		padding: 0;
		position: relative;
		display: grid;
		gap: 1.1rem;
	}

	.spine {
		position: absolute;
		left: 17px;
		top: 18px;
		bottom: 18px;
		width: 2px;
		background: var(--rule);
	}

	.spine span {
		display: block;
		height: 100%;
		background: linear-gradient(to bottom, #f0b90b, #0ecb81);
		transform-origin: 50% 0;
		transform: scaleY(0);
		box-shadow: 0 0 12px rgba(240, 185, 11, 0.6);
	}

	.station {
		position: relative;
		display: grid;
		grid-template-columns: 36px minmax(0, 1fr);
		gap: 1.1rem;
		align-items: start;
	}

	.node {
		position: relative;
		z-index: 1;
		display: grid;
		place-items: center;
		width: 36px;
		height: 36px;
		margin-top: 0.9rem;
		border-radius: 50%;
		background: var(--paper);
		border: 2px solid var(--rule);
		font-family: var(--font-mono);
		font-size: 0.8rem;
		font-weight: 700;
		color: var(--ink-faint);
		transition:
			border-color 0.4s ease,
			background 0.4s ease,
			color 0.4s ease,
			box-shadow 0.4s ease;
	}

	.station.lit .node {
		border-color: #f0b90b;
		background: #f0b90b;
		color: #0b0e11;
		box-shadow: 0 0 0 5px rgba(240, 185, 11, 0.18);
	}

	.station.capstone.lit .node {
		border-color: #0ecb81;
		background: #0ecb81;
		box-shadow: 0 0 0 5px rgba(14, 203, 129, 0.2);
	}

	.st-card {
		display: grid;
		gap: 0.35rem;
		padding: 1.05rem 1.25rem;
		border: 1px solid var(--rule);
		border-radius: 10px;
		background: var(--paper-raised);
		color: var(--ink);
		text-decoration: none;
		transition:
			border-color 0.3s ease,
			transform 0.3s ease,
			box-shadow 0.3s ease,
			opacity 0.5s ease;
	}

	.line.animated .station:not(.lit) .st-card {
		opacity: 0.45;
	}

	.st-card:hover {
		border-color: var(--mem);
		transform: translateX(4px);
		box-shadow: 0 12px 30px -18px rgba(0, 0, 0, 0.35);
	}

	.st-card:focus-visible {
		outline: 2px solid var(--mem);
		outline-offset: 3px;
	}

	.st-meta {
		display: flex;
		align-items: baseline;
		gap: 0.7rem;
	}

	.st-tag {
		font-family: var(--font-display);
		font-weight: 800;
		font-size: 1.15rem;
		color: var(--mem);
	}

	.capstone .st-tag {
		color: var(--compute);
	}

	.st-range {
		font-family: var(--font-mono);
		font-size: 0.74rem;
		color: var(--ink-faint);
	}

	.st-title {
		font-family: var(--font-display);
		font-weight: 600;
		font-size: 1.08rem;
	}

	.st-body {
		font-size: 0.9rem;
		line-height: 1.75;
		color: var(--ink-soft);
	}

	.st-out {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		margin-top: 0.25rem;
		font-size: 0.86rem;
		color: var(--compute);
	}

	.st-out i {
		display: grid;
		place-items: center;
		width: 18px;
		height: 18px;
		border-radius: 4px;
		background: var(--compute-wash);
		font-style: normal;
		font-weight: 700;
	}

	/* ---------- The repo window ---------- */
	.repo {
		background: #0d1117;
		border: 1px solid #30363d;
		border-radius: 12px;
		color: #e6edf3;
		font-size: 0.85rem;
		box-shadow:
			0 0 0 1px rgba(14, 203, 129, 0.06),
			0 40px 90px -35px rgba(0, 0, 0, 0.6);
		overflow: hidden;
		min-width: 0;
	}

	.repo-top {
		display: flex;
		align-items: center;
		gap: 0.6rem;
		padding: 0.9rem 1.1rem 0.6rem;
	}

	.repo-icon {
		width: 16px;
		height: 16px;
		fill: #8b949e;
		flex: none;
	}

	.repo-path {
		font-size: 1rem;
		color: #4493f8;
		min-width: 0;
		overflow: hidden;
		text-overflow: ellipsis;
		white-space: nowrap;
	}

	.repo-path b {
		font-weight: 600;
	}

	.pill {
		font-size: 0.7rem;
		padding: 0.05rem 0.5rem;
		border: 1px solid #30363d;
		border-radius: 999px;
		color: #8b949e;
	}

	.repo-star {
		margin-left: auto;
		font-size: 0.75rem;
		padding: 0.2rem 0.6rem;
		border: 1px solid #30363d;
		border-radius: 6px;
		background: #21262d;
		color: #e6edf3;
		white-space: nowrap;
	}

	.repo-tabs {
		display: flex;
		gap: 1.2rem;
		padding: 0 1.1rem;
		border-bottom: 1px solid #30363d;
		font-size: 0.8rem;
		color: #8b949e;
	}

	.repo-tabs span {
		display: inline-flex;
		align-items: center;
		gap: 0.35rem;
		padding: 0.55rem 0;
		border-bottom: 2px solid transparent;
	}

	.repo-tabs .on {
		color: #e6edf3;
		border-bottom-color: #f78166;
	}

	.repo-tabs em {
		font-style: normal;
		font-size: 0.68rem;
		padding: 0 0.4rem;
		border-radius: 999px;
		background: #30363d;
		color: #e6edf3;
	}

	.dot-ok {
		width: 8px;
		height: 8px;
		border-radius: 50%;
		background: #d29922;
		transition: background 0.3s ease;
	}

	.dot-ok.pass {
		background: #3fb950;
	}

	.repo-commit {
		display: flex;
		align-items: center;
		gap: 0.6rem;
		margin: 0.9rem 1.1rem 0;
		padding: 0.6rem 0.8rem;
		background: #161b22;
		border: 1px solid #30363d;
		border-radius: 8px 8px 0 0;
		font-family: var(--font-mono);
		font-size: 0.76rem;
	}

	.avatar {
		width: 18px;
		height: 18px;
		flex: none;
		border-radius: 50%;
		background: conic-gradient(#f0b90b, #0ecb81, #4493f8, #f0b90b);
	}

	.cm-msg {
		flex: 1;
		min-width: 0;
		white-space: nowrap;
		overflow: hidden;
	}

	.caret {
		display: inline-block;
		width: 7px;
		height: 1em;
		margin-left: 2px;
		vertical-align: -2px;
		background: #e6edf3;
		animation: blink 1s steps(2, start) infinite;
	}

	.cm-count {
		color: #8b949e;
		white-space: nowrap;
	}

	.files {
		list-style: none;
		margin: 0 1.1rem;
		padding: 0;
		border: 1px solid #30363d;
		border-top: 0;
		border-radius: 0 0 8px 8px;
		overflow: hidden;
	}

	.files li {
		display: grid;
		grid-template-columns: 16px 7.5rem minmax(0, 1fr) auto;
		gap: 0.7rem;
		align-items: center;
		padding: 0.5rem 0.8rem;
		border-top: 1px solid #21262d;
		font-size: 0.78rem;
	}

	.files li:first-child {
		border-top: 0;
	}

	.repo.animated .files li {
		opacity: 0;
		transform: translateX(-10px);
		transition:
			opacity 0.35s ease,
			transform 0.35s ease,
			background 1.2s ease;
	}

	.repo.animated .files li.on {
		opacity: 1;
		transform: none;
		animation: flash 1.2s ease;
	}

	@keyframes flash {
		from {
			background: rgba(240, 185, 11, 0.12);
		}
	}

	.f-ico {
		width: 14px;
		height: 12px;
		border-radius: 2px;
	}

	.f-ico.dir {
		background: #54aeff;
		clip-path: polygon(0 0, 40% 0, 50% 18%, 100% 18%, 100% 100%, 0 100%);
	}

	.f-ico.file {
		width: 11px;
		height: 14px;
		border: 1.5px solid #8b949e;
		background: none;
	}

	.f-name {
		font-family: var(--font-mono);
		color: #e6edf3;
		white-space: nowrap;
	}

	.f-msg {
		color: #8b949e;
		white-space: nowrap;
		overflow: hidden;
		text-overflow: ellipsis;
	}

	.f-day {
		font-family: var(--font-mono);
		font-size: 0.7rem;
		color: #6e7681;
		white-space: nowrap;
	}

	.checks {
		margin: 0.9rem 1.1rem 1.1rem;
		padding: 0.7rem 0.9rem;
		border: 1px solid #30363d;
		border-radius: 8px;
		background: #161b22;
	}

	.checks-title {
		margin: 0 0 0.4rem;
		font-size: 0.72rem;
		color: #8b949e;
	}

	.check {
		display: flex;
		align-items: center;
		gap: 0.6rem;
		margin: 0;
		padding: 0.25rem 0;
		font-family: var(--font-mono);
		font-size: 0.76rem;
		color: #8b949e;
	}

	.ci-state {
		position: relative;
		width: 14px;
		height: 14px;
		flex: none;
		border-radius: 50%;
		border: 1.5px solid #30363d;
	}

	.check.run .ci-state {
		border-color: #d29922;
		border-top-color: transparent;
		animation: spin 0.8s linear infinite;
	}

	.check.run {
		color: #e6edf3;
	}

	.check.pass {
		color: #e6edf3;
	}

	.check.pass .ci-state {
		border-color: #3fb950;
		background: #3fb950;
	}

	.check.pass .ci-state::after {
		content: '';
		position: absolute;
		left: 4px;
		top: 1.5px;
		width: 3px;
		height: 6px;
		border: solid #0d1117;
		border-width: 0 1.6px 1.6px 0;
		transform: rotate(45deg);
	}

	@keyframes spin {
		to {
			transform: rotate(360deg);
		}
	}

	/* ---------- Contribution grid + pinned repos ---------- */
	.pinned {
		display: grid;
		grid-template-columns: minmax(0, 1fr) minmax(0, 1.05fr);
		gap: clamp(2rem, 5vw, 4rem);
		align-items: start;
		padding-top: clamp(2.4rem, 5vw, 3.4rem);
	}

	.contrib-head {
		display: flex;
		justify-content: space-between;
		align-items: baseline;
		gap: 1rem;
		margin-bottom: 0.8rem;
	}

	.contrib-title,
	.pins-title {
		margin: 0;
		font-family: var(--font-display);
		font-weight: 600;
		font-size: 0.95rem;
	}

	.pins-title {
		margin-bottom: 0.8rem;
	}

	.contrib-legend {
		display: flex;
		align-items: center;
		gap: 3px;
		margin: 0;
		font-size: 0.72rem;
		color: var(--ink-faint);
	}

	.contrib-legend i,
	.cells i {
		display: block;
		border-radius: 3px;
	}

	.contrib-legend i {
		width: 11px;
		height: 11px;
	}

	.cells {
		display: grid;
		grid-template-columns: repeat(21, minmax(0, 1fr));
		gap: 4px;
	}

	.cells i {
		aspect-ratio: 1;
		border-radius: 2px;
		background: var(--rule-soft);
	}

	.lv1,
	.cells i.lv1 { background: #9be9a8; }
	.lv2,
	.cells i.lv2 { background: #40c463; }
	.lv3,
	.cells i.lv3 { background: #30a14e; }
	.lv4,
	.cells i.lv4 { background: #216e39; }

	.cells i[class^='lv']:not(.lv0) {
		transition:
			transform 0.4s cubic-bezier(0.3, 1.4, 0.5, 1),
			opacity 0.4s ease;
		transition-delay: calc(var(--d) * 22ms);
	}

	.cells i.lv0 {
		background: var(--rule-soft);
	}

	:global(.js-motion) .cells:not(.in) i:not(.lv0) {
		transform: scale(0.2);
		opacity: 0;
	}

	.pins ol {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 0.7rem;
	}

	.pins a {
		display: grid;
		gap: 0.3rem;
		height: 100%;
		box-sizing: border-box;
		padding: 0.85rem 1rem;
		border: 1px solid var(--rule);
		border-radius: 8px;
		background: var(--paper-raised);
		color: var(--ink);
		text-decoration: none;
		transition:
			border-color 0.25s ease,
			transform 0.25s ease;
	}

	.pins a:hover {
		border-color: var(--mem);
		transform: translateY(-2px);
	}

	.pins b {
		font-family: var(--font-mono);
		font-size: 0.86rem;
		color: var(--mem);
	}

	.pins span {
		font-size: 0.8rem;
		line-height: 1.55;
		color: var(--ink-soft);
	}

	.lang {
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
		font-style: normal;
		font-size: 0.74rem;
		color: var(--ink-faint);
	}

	.lang::before {
		content: '';
		width: 10px;
		height: 10px;
		border-radius: 50%;
		background: #3572a5;
	}

	.lang.ts::before {
		background: #3178c6;
	}

	.lang.more::before {
		background: #f0b90b;
	}

	@media (max-width: 960px) {
		.line-grid,
		.pinned {
			grid-template-columns: 1fr;
		}

		.stack-wrap {
			position: relative;
			top: 0;
		}
	}

	@media (max-width: 960px) {
		/* On narrow screens the stack sits above the stations; keep it compact. */
		.layers {
			flex-direction: row-reverse;
			flex-wrap: wrap-reverse;
			justify-content: flex-end;
		}

		.layer {
			padding: 0.4rem 0.6rem;
		}

		.layer-tag {
			width: auto;
		}

		.layer-name {
			display: none;
		}
	}

	@media (max-width: 560px) {
		.files li {
			grid-template-columns: 16px 6.4rem minmax(0, 1fr);
		}

		.f-day {
