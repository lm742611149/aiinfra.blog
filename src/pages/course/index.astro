---
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import { COURSE_SERIES, COURSE_TITLE, SITE_TITLE } from '../../consts';
import { breadcrumbSchema } from '../../lib/seo';

const TOTAL_DAYS = 61; // Day 0 + Day 1–60

const days = (
	await getCollection('blog', ({ data }) => !data.draft && data.series === COURSE_SERIES && data.day !== undefined)
).sort((a, b) => a.data.day! - b.data.day!);

// Group into the plan's weeks. Day 0 is the prologue; W7–W8 (Day 43–54) are the capstone.
const weekOf = (day: number) => {
	if (day === 0) return 0;
	if (day <= 42) return Math.ceil(day / 7);
	if (day <= 54) return 7;
	return 9;
};
const WEEK_TITLES: Record<number, string> = {
	0: '序章',
	1: 'W1 · 地基:大模型与 API',
	2: 'W2 · 工具调用与 Agent 循环',
	3: 'W3 · 上下文工程与 RAG',
	4: 'W4 · MCP、框架与多 Agent',
	5: 'W5 · 评测与可观测',
	6: 'W6 · 生产化',
	7: 'W7–W8 · 毕业项目 SupportPilot',
	9: 'W9 · 第二作品与求职',
};
const byMonth = new Map<number, typeof days>();
for (const d of days) {
	const m = weekOf(d.data.day!);
	byMonth.set(m, [...(byMonth.get(m) ?? []), d]);
}
const months = [...byMonth.keys()].sort((a, b) => a - b);
const pct = Math.round((days.length / TOTAL_DAYS) * 1000) / 10;

const description =
	'60 天 AI Agent 工程师速成课:大模型 API、function calling、手写 Agent 循环、RAG、MCP、LangGraph、评测、安全与部署,最后做一个完整的智能客服 Agent 项目并准备面试。每天一篇,配文档、B 站视频、书单和可运行代码。';
const schema = [
	{
		'@type': 'CollectionPage',
		'@id': new URL('/course/#series', Astro.site).toString(),
		name: COURSE_TITLE,
		url: new URL('/course/', Astro.site).toString(),
		description,
		inLanguage: 'zh-CN',
		isPartOf: { '@id': new URL('/#website', Astro.site).toString() },
		mainEntity: {
			'@type': 'ItemList',
			numberOfItems: days.length,
			itemListOrder: 'https://schema.org/ItemListOrderAscending',
			itemListElement: days.map((d) => ({
				'@type': 'ListItem',
				position: d.data.day! + 1,
				name: d.data.title,
				url: new URL(`/blog/${d.id}/`, Astro.site).toString(),
			})),
		},
	},
	breadcrumbSchema(Astro.site, [
		{ name: SITE_TITLE, path: '/' },
		{ name: COURSE_TITLE, path: '/course/' },
	]),
];
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<BaseHead title={`${COURSE_TITLE} — ${SITE_TITLE}`} description={description} lang="zh" schema={schema} />
	</head>
	<body>
		<Header />
		<main class="shell">
			<div class="page-head">
				<p class="label">agent-60</p>
				<h1>{COURSE_TITLE}</h1>
				<p class="lede">
					写给有编程经验、想转 AI Agent 工程师的人。不讲模型训练和数学,只讲招聘要的东西:调 API、设计工具、做 RAG、
					接 MCP、写评测、上生产。每天一篇,不限时,有空就学。从 Day 0 开始按顺序走,第 60 天带着两个项目去面试。
				</p>
				<div class="progress" role="group" aria-label="Progress">
					<div class="progress-meta">
						<span class="num">已发布 {days.length} / {TOTAL_DAYS} 篇</span>
						<span class="num">{pct}%</span>
					</div>
					<div class="track"><div class="fill" style={`width:${Math.max(pct, 0.6)}%`}></div></div>
					{days[0] && <p class="latest"><a href={`/blog/${days[0].id}/`}>从 Day 0 开始 →</a></p>}
					<p class="latest"><a href="/blog/agent-jd-report-2026-10/">先看看招聘方要什么:880 条真实 JD 拆解 →</a></p>
				</div>
			</div>

			{
				months.map((m) => (
					<section class="month">
						<h2 class="month-title">{WEEK_TITLES[m] ?? `W${m}`}</h2>
						<ol class="days">
							{byMonth.get(m)!.map((d) => (
								<li class:list={['day', `regime-${d.data.regime}`]}>
									<a class="day-num" href={`/blog/${d.id}/`}>
										Day {String(d.data.day).padStart(2, '0')}
									</a>
									<div class="day-body">
										<h3>
											<a href={`/blog/${d.id}/`}>{d.data.title.replace(/^Day \d+ · /, '')}</a>
										</h3>
										<p>{d.data.description}</p>
										{d.data.regime !== 'none' && (
											<div class="day-meta">
												<span class="regime">{d.data.regime}-bound</span>
											</div>
										)}
									</div>
								</li>
							))}
						</ol>
					</section>
				))
			}

			{days.length === 0 && <p class="empty">还没有开始。</p>}

			<section class="rules">
				<h2 class="month-title">怎么学</h2>
				<ul>
					<li>每篇先看「今天要解决的问题」,学完回来对照,答不上来就是没学会。</li>
					<li>视频和文档挑着看,「动手练习」一定要做,代码自己敲,跑通了才算过。</li>
					<li>每周最后一天是复习和小项目,前面几周的代码会一路拼成毕业项目。</li>
					<li>自测题先自己写答案再展开。标了「面试题」的,试着用一分钟口头讲清楚。</li>
				</ul>
			</section>
		</main>
		<Footer />
	</body>
</html>

<style>
	.page-head {
		padding-block: clamp(2.5rem, 6vw, 4rem) 1.5rem;
		border-bottom: var(--rule-weight) solid var(--rule);
	}

	.page-head .label {
		margin-bottom: 0.75rem;
	}

	h1 {
		font-size: clamp(1.9rem, 4vw, 2.6rem);
		margin-bottom: 0.9rem;
		letter-spacing: 0;
	}

	.lede {
		font-size: 1.04rem;
		line-height: 1.8;
		color: var(--ink-soft);
		max-width: 40rem;
		margin: 0 0 1.5rem;
	}

	.progress {
		max-width: 40rem;
	}

	.progress-meta {
		display: flex;
		justify-content: space-between;
		font-family: var(--font-mono);
		font-size: 0.74rem;
		letter-spacing: 0.08em;
		color: var(--ink-faint);
		margin-bottom: 0.45rem;
	}

	.track {
		height: 4px;
		background: var(--rule-soft);
		border-radius: 999px;
		overflow: hidden;
	}

	.fill {
		height: 100%;
		background: var(--mem);
		border-radius: 999px;
	}

	.latest {
		margin: 0.6rem 0 0;
		font-family: var(--font-mono);
		font-size: 0.72rem;
		letter-spacing: 0.06em;
		color: var(--ink-faint);
	}

	.month {
		padding-top: 2.25rem;
	}

	.month-title {
		font-family: var(--font-mono);
		font-weight: 500;
		font-size: 0.74rem;
		letter-spacing: 0.14em;
		color: var(--ink-faint);
		margin-bottom: 0.5rem;
		text-transform: none;
	}

	.days {
		list-style: none;
		margin: 0;
		padding: 0;
	}

	.day {
		display: grid;
		grid-template-columns: 6.5rem 1fr;
		gap: 1.5rem;
		padding-block: 1.4rem;
		border-bottom: var(--rule-weight) solid var(--rule-soft);
	}

	.day-num {
		align-self: start;
		justify-self: start;
		font-family: var(--font-mono);
		font-size: 0.78rem;
		letter-spacing: 0.08em;
		text-decoration: none;
		color: var(--ink);
		background: var(--paper-raised);
		border: 1px solid var(--rule);
		border-radius: 3px;
		padding: 0.2rem 0.55rem;
		margin-top: 0.15rem;
	}

	.regime-memory .day-num {
		border-left: 3px solid var(--mem);
	}

	.regime-compute .day-num {
		border-left: 3px solid var(--compute);
	}

	.day-num:hover {
		color: var(--mem);
		border-color: var(--mem);
	}

	.day-body h3 {
		font-size: 1.22rem;
		margin: 0 0 0.4rem;
		letter-spacing: 0;
		line-height: 1.4;
	}

	.day-body h3 a {
		text-decoration: none;
	}

	.day-body h3 a:hover {
		color: var(--mem);
	}

	.day-body p {
		margin: 0;
		color: var(--ink-soft);
		font-size: 0.96rem;
		line-height: 1.75;
		max-width: 40rem;
	}

	.day-meta {
		display: flex;
		gap: 0.9rem;
		margin-top: 0.55rem;
		font-family: var(--font-mono);
		font-size: 0.7rem;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--ink-faint);
	}

	.regime {
		border-left: 2px solid var(--rule);
		padding-left: 0.5rem;
	}

	.regime-memory .regime {
		border-left-color: var(--mem);
		color: var(--mem);
	}

	.regime-compute .regime {
		border-left-color: var(--compute);
		color: var(--compute);
	}

	.rules {
		padding-top: 2.5rem;
	}

	.rules ul {
		margin: 0;
		padding-left: 1.2rem;
		color: var(--ink-soft);
		line-height: 1.85;
	}

	.empty {
		padding-block: 3rem;
		color: var(--ink-soft);
	}

	@media (max-width: 600px) {
		.day {
			grid-template-columns: 1fr;
			gap: 0.6rem;
		}
	}
</style>
